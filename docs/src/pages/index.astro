    <!-- ── INTERACTIVE CLIENT LOGIC ── -->
    <script>
      // 1. Interactive Workbench Tab Switcher
      document.querySelectorAll('[data-workbench]').forEach((wb) => {
        const tabs = wb.querySelectorAll('.rig-tab');
        const panels = wb.querySelectorAll('.specimen-panel');
        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const specId = 'specimen-' + tab.getAttribute('data-specimen');
            tabs.forEach((t) => t.classList.remove('is-active'));
            panels.forEach((p) => p.classList.remove('is-active'));
            tab.classList.add('is-active');
            const target = document.getElementById(specId);
            if (target) target.classList.add('is-active');
          });
        });
      });

      // 2. Interactive Ledger Math Calculator
      const slider = document.getElementById('prompt-slider');
      const promptsLabel = document.getElementById('calc-prompts-label');
      const rowWithoutTokens = document.getElementById('row-without-tokens');
      const rowWithTokens = document.getElementById('row-with-tokens');
      const rowDeltaTokens = document.getElementById('row-delta-tokens');
      const rowWithoutCost = document.getElementById('row-without-cost');
      const rowWithCost = document.getElementById('row-with-cost');
      const rowDeltaCost = document.getElementById('row-delta-cost');

      if (slider && promptsLabel) {
        slider.addEventListener('input', (e) => {
          const tasks = parseInt(e.target.value, 10);
          promptsLabel.textContent = tasks.toLocaleString();

          const withoutTok = tasks * 45000;
          const withTok = tasks * 260;
          const deltaTok = withoutTok - withTok;

          const withoutC = (withoutTok / 1000000) * 3.0 * 30; // monthly
          const withC = (withTok / 1000000) * 3.0 * 30;
          const deltaC = withoutC - withC;

          if (rowWithoutTokens) rowWithoutTokens.textContent = `${withoutTok.toLocaleString()} tokens/day`;
          if (rowWithTokens) rowWithTokens.textContent = `${withTok.toLocaleString()} tokens/day`;
          if (rowDeltaTokens) rowDeltaTokens.textContent = `−${deltaTok.toLocaleString()} tokens/day`;

          if (rowWithoutCost) rowWithoutCost.textContent = `$${withoutC.toFixed(2)} / mo`;
          if (rowWithCost) rowWithCost.textContent = `$${withC.toFixed(2)} / mo`;
          if (rowDeltaCost) rowDeltaCost.textContent = `+$${deltaC.toFixed(2)} / mo SAVED`;
        });
      }
    </script>
