---
import "../styles/global.css";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Stop teaching your AI the same architecture twice. Engrams is the cognitive schema runtime that intercepts agent edits in 1ms with 250-token mental models instead of 50,000-token file reads."
    />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Engrams — Cognitive Schema Engine for AI Coding Agents</title>
  </head>
  <body class="ledger-body">
    <!-- ── TOP TELEMETRY MASTHEAD ── -->
    <header class="masthead">
      <div class="masthead-inner">
        <div class="masthead-brand">
          <a href="/" class="brand-link">
            <span class="brand-glyph">⬡</span>
            <span class="brand-name">ENGRAMS</span>
            <span class="brand-version">v0.14.0</span>
          </a>
          <span class="masthead-sub">COGNITIVE SCHEMA RUNTIME</span>
        </div>
        <nav class="masthead-nav">
          <a href="#trace" class="nav-item">Execution Trace</a>
          <a href="#thesis" class="nav-item">Why Schemas</a>
          <a href="#workbench" class="nav-item">Workbench</a>
          <a href="#ledger" class="nav-item">Token Math</a>
          <a href="/docs/guide/cognitive-schemas" class="nav-item highlight">Guide</a>
          <a href="/docs/getting-started" class="nav-item">Docs</a>
          <a href="https://github.com/stevebrownlee/engrams-cli" target="_blank" rel="noopener" class="nav-item">GitHub ↗</a>
        </nav>
      </div>
    </header>

    <!-- ══ SECTION 1: THE DUAL EXECUTION TRACE (HERO) ══ -->
    <main>
      <section id="trace" class="trace-section">
        <div class="trace-container">
          <div class="hero-manifesto">
            <div class="kicker-tag">ARCHITECTURAL FIELD MANUAL // 0MB BACKGROUND RAM // 1MS SQLITE</div>
            <h1 class="hero-headline">
              Stop teaching your AI<br />
              <span class="gold-text">the same architecture twice.</span>
            </h1>
            <p class="hero-lede">
              AI agents suffer from complete amnesia between conversations. To guess your conventions,
              they burn 50,000 tokens reading 15 files defensively. Engrams automatically organizes your
              codebase history into <strong>Cognitive Schemas</strong> — compact mental models that tell your
              agent how to build before it opens a single file.
            </p>
          </div>

          <!-- THE LIVE TRACE RUNNER -->
          <div class="trace-runner">
            <!-- Global Command Bar -->
            <div class="command-bar">
              <span class="prompt-symbol">$</span>
              <span class="prompt-label">PROMPT:</span>
              <span class="prompt-text">"Add webhook signature verification to our Stripe payment adapter."</span>
            </div>

            <!-- Dual Split Lanes -->
            <div class="split-lanes">
              <!-- LANE A: THE AMNESIAC EXPLORATION -->
              <div class="lane lane-amnesiac">
                <div class="lane-header">
                  <div class="lane-badge badge-red">TRACE 01 // UNCONSTRAINED CONTEXT DUMP</div>
                  <div class="lane-metrics">48,200 TOKENS · 52.4s · 4 TOOL ROUNDS</div>
                </div>

                <div class="lane-body">
                  <div class="trace-log">
                    <div class="log-entry">
                      <span class="log-time">00.1s</span>
                      <span class="log-action">tool:read_file</span>
                      <span class="log-target">src/billing/service.rs</span>
                      <span class="log-cost">+12,410 tok</span>
                    </div>
                    <div class="log-entry">
                      <span class="log-time">01.4s</span>
                      <span class="log-action">tool:read_file</span>
                      <span class="log-target">src/config.rs</span>
                      <span class="log-cost">+8,920 tok</span>
                    </div>
                    <div class="log-entry">
                      <span class="log-time">03.2s</span>
                      <span class="log-action">tool:read_file</span>
                      <span class="log-target">src/api/routes.rs</span>
                      <span class="log-cost">+15,100 tok</span>
                    </div>
                    <div class="log-entry">
                      <span class="log-time">04.8s</span>
                      <span class="log-action">tool:read_file</span>
                      <span class="log-target">src/adapters/stripe.rs</span>
                      <span class="log-cost">+11,770 tok</span>
                    </div>
                  </div>

                  <!-- Diff output with red critique annotations -->
                  <div class="diff-block diff-bad">
                    <div class="diff-header">
                      <span>GENERATED CODE // FAILED PR REVIEW</span>
                      <span class="diff-status text-red">3 CONVENTION VIOLATIONS</span>
                    </div>
                    <pre class="diff-code"><code>// Agent invents ad-hoc helper, ignoring codebase architecture
pub fn verify_signature(secret: &str, sig: &str) -> bool &#123;
<span class="critique-line bad">  // ❌ VIOLATION: ADR #44 requires PaymentProvider interface</span>
<span class="critique-line bad">  // ❌ FLAW: Leaks timing attacks (Pattern #8 requires crypto::constant_time_eq)</span>
<span class="critique-line bad">  // ❌ DUPLICATION: Re-implements hex_decode instead of crate::crypto</span>
  sig == compute_hmac(secret)
&#125;</code></pre>
                  </div>
                </div>

                <div class="lane-footer footer-bad">
                  <div class="footer-status">RESULT: 52s WASTED · $0.144 BURNED · CODE REVIEW REJECTED</div>
                </div>
              </div>

              <!-- LANE B: THE SCHEMA-GUIDED EXECUTION -->
              <div class="lane lane-schema">
                <div class="lane-header">
                  <div class="lane-badge badge-gold">TRACE 02 // SCHEMA-INTERCEPTED EXECUTION</div>
                  <div class="lane-metrics text-gold">260 TOKENS · 3.1s · 0 FILES READ</div>
                </div>

                <div class="lane-body">
                  <div class="trace-log">
                    <div class="log-entry log-intercept">
                      <span class="log-time">00.001s</span>
                      <span class="log-action text-gold">intercept</span>
                      <span class="log-target">engrams advise src/adapters/stripe.rs</span>
                      <span class="log-cost text-gold">1ms [SQLite]</span>
                    </div>
                  </div>

                  <!-- Injected Schema Box -->
                  <div class="schema-intercept-box">
                    <div class="sib-head">
                      <span class="sib-label">INJECTED SCHEMA</span>
                      <span class="sib-name">payment-adapters</span>
                      <span class="sib-telemetry">guided 14 sessions</span>
                    </div>
                    <div class="sib-content">
                      <div class="sib-row">
                        <span class="sib-k">⚡ TRIGGER</span>
                        <span class="sib-v">Fires when editing payment adapter implementations</span>
                      </div>
                      <div class="sib-row">
                        <span class="sib-k">📋 DIRECTIVE</span>
                        <span class="sib-v text-gold">Implement PaymentProvider; verify signatures with crypto::constant_time_eq; never log raw webhook payloads.</span>
                      </div>
                      <div class="sib-row">
                        <span class="sib-k">🔗 MEMBERS</span>
                        <span class="sib-v">ADR #44 (trait contract) · Pattern #8 (constant_time_eq) · 3 anchors</span>
                      </div>
                    </div>
                  </div>

                  <!-- Diff output with green verified annotations -->
                  <div class="diff-block diff-good">
                    <div class="diff-header">
                      <span>GENERATED CODE // TURN 1 ZERO-SHOT</span>
                      <span class="diff-status text-green">100% INVARIANT COMPLIANT</span>
                    </div>
                    <pre class="diff-code"><code>impl PaymentProvider for StripeAdapter &#123;
<span class="critique-line good">  // ✓ Satisfies ADR #44: Pluggable provider interface</span>
<span class="critique-line good">  // ✓ Satisfies Pattern #8: Constant-time byte comparison against timing attacks</span>
  fn verify_webhook(&self, payload: &[u8], sig: &str) -> Result&lt;bool&gt; &#123;
    crypto::constant_time_eq(sig.as_bytes(), &self.compute_sig(payload))
  &#125;
&#125;</code></pre>
                  </div>
                </div>

                <div class="lane-footer footer-good">
                  <div class="footer-status">RESULT: 3.1s TURN · 47,940 TOKENS SAVED · MERGED ON TURN 1</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ══ SECTION 2: THE COGNITIVE THESIS ══ -->
      <section id="thesis" class="thesis-section">
        <div class="thesis-container">
          <div class="thesis-quote-col">
            <blockquote class="thesis-statement">
              "AI models do not fail because they lack raw intelligence. They fail because they lack
              <span class="gold-text">mental models</span>."
            </blockquote>
            <p class="thesis-cite">— The Architectural Thesis of Engrams</p>
          </div>

          <div class="thesis-body-col">
            <h2>The Psychology of Codebase Expertise</h2>
            <p>
              When a senior engineer joins a project, they spend weeks assimilating how things are done.
              After six months, they don't re-read the company manual before every pull request.
              Their brain has crystallized dozens of individual decisions, bugs, and rules into
              <strong>cognitive schemas</strong> — fluid mental models that fire conditionally:
            </p>
            <div class="quote-callout">
              <em>"When I edit database code here, I borrow parameters and never build throwaway Vecs."</em>
            </div>
            <p>
              Today's AI coding tools operate in a permanent state of novice confusion. They force the agent to
              re-discover your entire system from scratch on every prompt by scraping raw syntax.
            </p>

            <!-- THE THREE-TIER CODEBASE REALITY -->
            <div class="tier-pyramid">
              <div class="tier-level tier-3">
                <div class="tier-badge">TIER 3 // 250 TOKENS</div>
                <div class="tier-title">Cognitive Schemas</div>
                <div class="tier-desc">Active conceptual playbooks: <em>"Fires when X: Do Y"</em>. Injected in 1ms.</div>
              </div>
              <div class="tier-arrow">▲ Engrams operates here (95% of sessions)</div>
              <div class="tier-level tier-2">
                <div class="tier-badge">TIER 2 // 1,500 TOKENS</div>
                <div class="tier-title">Decisions, Patterns &amp; Contracts</div>
                <div class="tier-desc">The underlying reasoning, error signatures, and anchored files.</div>
              </div>
              <div class="tier-arrow">▲ Conventional tools dump everything here</div>
              <div class="tier-level tier-1">
                <div class="tier-badge">TIER 1 // 50,000+ TOKENS</div>
                <div class="tier-title">Raw Source Code &amp; Multi-File Diffs</div>
                <div class="tier-desc">Defensive file reads, attention decay, and exploratory tool loops.</div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ══ SECTION 3: THE THREE ERAS ══ -->
      <section id="eras" class="eras-section">
        <div class="section-lead">
          <span class="mono-label">CHRONOLOGY // TOOLING EVOLUTION</span>
          <h2>The Three Eras of AI Context</h2>
        </div>

        <div class="eras-table">
          <div class="era-row">
            <div class="era-col-year">2023</div>
            <div class="era-col-name">The Raw Prompt Era</div>
            <div class="era-col-mechanism">Dumping complete READMEs, full repo trees, and naive RAG chunks into the prompt window.</div>
            <div class="era-col-flaw">100k token bills, model attention rot, extreme tool-loop latency.</div>
          </div>

          <div class="era-row">
            <div class="era-col-year">2024–2025</div>
            <div class="era-col-name">The Memory Store Era</div>
            <div class="era-col-mechanism">Flat vector databases, unorganized ADR files, and static <code>.cursorrules</code> files.</div>
            <div class="era-col-flaw">200 disconnected notes. The agent has facts, but no trigger condition — it doesn't know <em>which</em> rule applies right now.</div>
          </div>

          <div class="era-row era-active">
            <div class="era-col-year text-gold">NOW</div>
            <div class="era-col-name text-gold">The Cognitive Schema Era</div>
            <div class="era-col-mechanism">Autonomous graph clustering that packages decisions, patterns, and code into active mental models with triggers and directives.</div>
            <div class="era-col-flaw text-green">260 tokens injected in 1ms. Zero file reads required. Senior engineer precision.</div>
          </div>
        </div>
      </section>

      <!-- ══ SECTION 4: THE SCHEMA WORKBENCH ══ -->
      <section id="workbench" class="workbench-section">
        <div class="section-lead">
          <span class="mono-label">INSPECTION CONSOLE // REAL-WORLD ARTIFACTS</span>
          <h2>Deconstructing a Schema</h2>
          <p class="section-subtext">Click through real schemas running on this repository to inspect their anatomy.</p>
        </div>

        <div class="workbench-rig" data-workbench>
          <div class="rig-tabs">
            <button class="rig-tab is-active" data-specimen="db">
              <span class="tab-index">01</span>
              <span class="tab-name">performance-rules</span>
              <span class="tab-tag">Database</span>
            </button>
            <button class="rig-tab" data-specimen="payment">
              <span class="tab-index">02</span>
              <span class="tab-name">payment-adapters</span>
              <span class="tab-tag">API Integration</span>
            </button>
            <button class="rig-tab" data-specimen="auth">
              <span class="tab-index">03</span>
              <span class="tab-name">auth-session-tokens</span>
              <span class="tab-tag">Security</span>
            </button>
          </div>

          <!-- Specimen 1: Database -->
          <div class="specimen-panel is-active" id="specimen-db">
            <div class="panel-terminal">
              <div class="pt-bar">
                <span class="pt-title">$ engrams schema show performance-rules</span>
                <span class="pt-status text-green">● ACTIVE [GUIDED 14 SESSIONS]</span>
              </div>
              <div class="pt-body">
                <div class="pt-segment">
                  <span class="pt-key">TARGET SCOPE</span>
                  <div class="pt-data font-bold">src/db/**/*.rs · src/ops/schemas/**/*.rs</div>
                </div>
                <div class="pt-segment">
                  <span class="pt-key">⚡ ACTIVATION TRIGGER</span>
                  <div class="pt-data text-white font-bold">Fires when editing Rust code that creates, copies, or hands off collections and strings</div>
                </div>
                <div class="pt-segment">
                  <span class="pt-key">📋 OPERATIONAL DIRECTIVE</span>
                  <div class="pt-data text-gold highlight-box">
                    Borrow SQL parameters via Vec&lt;&amp;dyn ToSql&gt;; consume temporary lookup maps by move with remove(); never materialize intermediate throwaway Vecs.
                  </div>
                </div>
                <div class="pt-segment">
                  <span class="pt-key">🔗 BUNDLED MEMBERS (4)</span>
                  <div class="pt-tags">
                    <span class="t-pill">Decision #88: Borrowed SQL params</span>
                    <span class="t-pill">Decision #91: Static vocabulary returns Cow</span>
                    <span class="t-pill">Pattern #12: Enrich by move</span>
                    <span class="t-pill anchor">Anchor: src/ops/schemas/retrieval.rs</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Specimen 2: Payment -->
          <div class="specimen-panel" id="specimen-payment">
            <div class="panel-terminal">
              <div class="pt-bar">
                <span class="pt-title">$ engrams schema show payment-adapters</span>
                <span class="pt-status text-green">● ACTIVE [GUIDED 9 SESSIONS]</span>
              </div>
              <div class="pt-body">
                <div class="pt-segment">
                  <span class="pt-key">TARGET SCOPE</span>
                  <div class="pt-data font-bold">src/adapters/**/*.rs · src/billing/**/*.rs</div>
                </div>
                <div class="pt-segment">
                  <span class="pt-key">⚡ ACTIVATION TRIGGER</span>
                  <div class="pt-data text-white font-bold">Fires when editing payment adapter implementations or checkout flows</div>
                </div>
                <div class="pt-segment">
                  <span class="pt-key">📋 OPERATIONAL DIRECTIVE</span>
                  <div class="pt-data text-gold highlight-box">
                    Implement PaymentProvider trait; pass idempotency_key to all charge requests; verify signatures with crypto::constant_time_eq.
                  </div>
                </div>
                <div class="pt-segment">
                  <span class="pt-key">🔗 BUNDLED MEMBERS (3)</span>
                  <div class="pt-tags">
                    <span class="t-pill">Decision #44: PaymentProvider interface contract</span>
                    <span class="t-pill">Pattern #8: Constant-time signature verification</span>
                    <span class="t-pill anchor">Anchor: src/adapters/stripe.rs</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Specimen 3: Auth -->
          <div class="specimen-panel" id="specimen-auth">
            <div class="panel-terminal">
              <div class="pt-bar">
                <span class="pt-title">$ engrams schema show auth-session-tokens</span>
                <span class="pt-status text-green">● ACTIVE [GUIDED 18 SESSIONS]</span>
              </div>
              <div class="pt-body">
                <div class="pt-segment">
                  <span class="pt-key">TARGET SCOPE</span>
                  <div class="pt-data font-bold">src/auth/**/*.rs · src/middleware/**/*.rs</div>
                </div>
                <div class="pt-segment">
                  <span class="pt-key">⚡ ACTIVATION TRIGGER</span>
                  <div class="pt-data text-white font-bold">Fires when editing session token validation or login route handlers</div>
                </div>
                <div class="pt-segment">
                  <span class="pt-key">📋 OPERATIONAL DIRECTIVE</span>
                  <div class="pt-data text-gold highlight-box">
                    Validate tokens strictly at boundary middleware; never pass raw JWT strings into domain services; use SessionContext struct.
                  </div>
                </div>
                <div class="pt-segment">
                  <span class="pt-key">🔗 BUNDLED MEMBERS (3)</span>
                  <div class="pt-tags">
                    <span class="t-pill">Decision #19: Token validation at middleware boundary</span>
                    <span class="t-pill">Decision #23: Typed SessionContext envelope</span>
                    <span class="t-pill anchor">Anchor: src/middleware/auth.rs</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ══ SECTION 5: THE TOKEN ECONOMICS LEDGER ══ -->
      <section id="ledger" class="ledger-section">
        <div class="section-lead">
          <span class="mono-label">THE BALANCE SHEET // MEASURED TOKENS</span>
          <h2>The Token Economics Ledger</h2>
          <p class="section-subtext">Token savings aren't speculative. They are calculated directly at every session close.</p>
        </div>

        <div class="ledger-calculator" data-calc>
          <div class="calc-header-bar">
            <div class="ch-label">
              <span>TEAM ACTIVITY PARAMETER:</span>
              <strong id="calc-prompts-label">100</strong> tasks / day
            </div>
            <input
              type="range"
              id="prompt-slider"
              min="10"
              max="500"
              step="10"
              value="100"
              class="sharp-slider"
            />
          </div>

          <table class="financial-table">
            <thead>
              <tr>
                <th>OPERATIONAL METRIC</th>
                <th>CONVENTIONAL AI AGENT</th>
                <th>ENGRAMS SCHEMA AGENT</th>
                <th class="text-right">NET DELTA</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><strong>Context Load per Task</strong></td>
                <td>45,000 tokens (defensive reads)</td>
                <td><strong class="text-gold">260 tokens</strong> (injected schema)</td>
                <td class="text-right text-green">−99.4% context load</td>
              </tr>
              <tr>
                <td><strong>Exploratory Tool Loops</strong></td>
                <td>6 to 12 file reads / task</td>
                <td><strong class="text-gold">0 file reads</strong> (rules provided)</td>
                <td class="text-right text-green">Instant Turn 1 start</td>
              </tr>
              <tr>
                <td><strong>Daily Token Consumption</strong></td>
                <td id="row-without-tokens">4,500,000 tokens/day</td>
                <td id="row-with-tokens" class="text-gold">26,000 tokens/day</td>
                <td id="row-delta-tokens" class="text-right text-green">−4,474,000 tokens/day</td>
              </tr>
              <tr class="highlight-row">
                <td><strong>Monthly Financial Cost ($3/Mtok)</strong></td>
                <td id="row-without-cost">$405.00 / mo</td>
                <td id="row-with-cost" class="text-gold">$2.34 / mo</td>
                <td id="row-delta-cost" class="text-right text-green">+$402.66 / mo SAVED</td>
              </tr>
              <tr>
                <td><strong>Monthly Engineer Tool Latency</strong></td>
                <td>43.3 hours waiting</td>
                <td>2.5 hours waiting</td>
                <td class="text-right text-green">+40.8 hours recovered</td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- The 3 System Invariants -->
        <div class="invariants-row">
          <div class="inv-block">
            <span class="inv-k">FOOTPRINT</span>
            <span class="inv-v">0 MB RAM</span>
            <p>Zero running Node daemons, no background socket drops. A compiled Rust binary that executes in 1ms and exits.</p>
          </div>
          <div class="inv-block">
            <span class="inv-k">SEARCH ENGINE</span>
            <span class="inv-v">1 ms SQLite</span>
            <p>Built-in FTS5 engine and graph traversal. Zero external embedding APIs, zero network round-trips, works 100% offline.</p>
          </div>
          <div class="inv-block">
            <span class="inv-k">VERSIONING</span>
            <span class="inv-v">Git-Native</span>
            <p>Automatic <code>export</code> and <code>import</code> transforms database state into human-readable Markdown for team PR reviews.</p>
          </div>
        </div>
      </section>

      <!-- ══ SECTION 6: THE ZERO-MAINTENANCE PROTOCOL ══ -->
      <section class="protocol-section">
        <div class="section-lead">
          <span class="mono-label">WORKFLOW PROTOCOL // ZERO BOOKKEEPING</span>
          <h2>The Loop That Closes Itself</h2>
          <p class="section-subtext">You never write schemas from scratch. The system detects them, prompts you, and activates them.</p>
        </div>

        <div class="protocol-steps">
          <div class="proto-step">
            <div class="ps-num">01</div>
            <h3>Graph Clustering</h3>
            <p>As you commit code and log decisions, community detection identifies co-edited clusters in local SQLite.</p>
          </div>
          <div class="proto-step">
            <div class="ps-num">02</div>
            <h3>Session Nudge</h3>
            <p>At <code>session close</code>, Engrams surfaces passing clusters with a ready-to-run <code>confirm</code> command.</p>
          </div>
          <div class="proto-step">
            <div class="ps-num">03</div>
            <h3>Pre-Edit Intercept</h3>
            <p>Tomorrow, your AI touches matching files. <code>advise</code> silently injects the schema before a line is written.</p>
          </div>
          <div class="proto-step">
            <div class="ps-num">04</div>
            <h3>Verified Receipts</h3>
            <p>Every session close records <code>schema_value: &#123; guided_retrievals: N &#125;</code>, proving exact tokens saved.</p>
          </div>
        </div>
      </section>

      <!-- ══ SECTION 7: THREE OPERATIONAL COMMANDS ══ -->
      <section class="commands-section">
        <div class="section-lead">
          <span class="mono-label">CLI INTERFACE // RUNTIME COMMANDS</span>
          <h2>Three Levers for the Human</h2>
          <p class="section-subtext">Your AI executes the advice. You steer with three high-leverage commands.</p>
        </div>

        <div class="cmd-stack">
          <!-- Command 1 -->
          <div class="cmd-box">
            <div class="cb-chrome">
              <span class="cb-cmd">$ engrams advise src/adapters/stripe.rs</span>
              <span class="cb-desc">AUTOMATIC PRE-EDIT INTERCEPTOR</span>
            </div>
            <pre class="cb-body"><code>&#123;
  "schemas": [
    &#123;"id": 1, "name": "payment-adapters", "summary": "Fires when editing payment adapters: implement PaymentProvider..."&#125;
  ],
  "constraints": [ ... ]
&#125;</code></pre>
          </div>

          <!-- Command 2 -->
          <div class="cmd-box">
            <div class="cb-chrome">
              <span class="cb-cmd">$ engrams schema show payment-adapters</span>
              <span class="cb-desc">CONCEPTUAL SPECIMEN INSPECTOR</span>
            </div>
            <pre class="cb-body"><code>&#123;
  "name": "payment-adapters",
  "summary": "Fires when editing payment adapters...",
  "guided": 9,
