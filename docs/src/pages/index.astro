---
import "../styles/global.css";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Engrams is the Schema Runtime for AI agents. It isn't a passive memory store or static markdown rules — it's an active runtime that finds, defines, and refines mental models like the human brain."
    />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Engrams — The Schema Runtime for AI Agents</title>
  </head>
  <body class="runtime-body">
    <!-- ── TOP BAR ── -->
    <header class="top-bar">
      <div class="bar-inner">
        <a href="/" class="brand">
          <span class="glyph">⬡</span>
          <span class="name">ENGRAMS</span>
          <span class="version">v0.15.0</span>
        </a>
        <nav class="nav">
          <a href="#what">What is a Schema</a>
          <a href="#runtime">Why a Runtime</a>
          <a href="#lifecycle">How It Learns</a>
          <a href="/docs/guide/cognitive-schemas" class="highlight">Guide</a>
          <a href="/docs/getting-started">Docs</a>
          <a href="https://github.com/stevebrownlee/engrams-cli" target="_blank" rel="noopener">GitHub ↗</a>
        </nav>
      </div>
    </header>

    <main class="page-content">
      <!-- ══ 1. THE HERO ══ -->
      <section class="hero-section">
        <h1 class="hero-title">
          The Schema Runtime<br />
          <span class="accent">for AI Coding Agents.</span>
        </h1>
        <p class="hero-lede">
          Static markdown rules bloat your prompt. Flat memory stores sit passively waiting to be queried.
          Engrams is an <strong>active runtime</strong> that continuously finds, defines, and refines
          mental models for your codebase — just like the human brain.
        </p>

        <div class="hero-actions">
          <a href="/docs/quick-start" class="btn-action primary">5-Minute Quick Start</a>
          <a href="/docs/guide/cognitive-schemas" class="btn-action secondary">Read the Schema Guide</a>
        </div>
      </section>

      <!-- ══ 2. WHY A RUNTIME? (CATEGORICAL SEPARATION) ══ -->
      <section id="runtime" class="content-section">
        <h2 class="section-heading">Why a Schema Runtime?</h2>
        <p class="section-description">
          Other tools treat AI context as static text files or dead database records. A runtime is fundamentally different:
          it actively perceives changes, clusters patterns, and executes directives at the exact point of action.
        </p>

        <div class="runtime-matrix">
          <div class="matrix-card">
            <h3>Vector Databases &amp; ADR Lists (Passive)</h3>
            <div class="matrix-flaw">Dead history waiting to be searched</div>
            <p>
              Stores hundreds of isolated notes. But the agent has no trigger condition — it doesn't know
              <em>when</em> a rule applies. It either queries blindly or ignores your history completely.
            </p>
          </div>

          <div class="matrix-card">
            <h3>Prompt Stuffing &amp; <code>.cursorrules</code> (Static)</h3>
            <div class="matrix-flaw">Brittle, manual, and bloated</div>
            <p>
              Developers manually write rigid text rules that get dumped into every prompt regardless of relevance.
              Consumes context window space and causes severe attention decay in reasoning models.
            </p>
          </div>

          <div class="matrix-card matrix-featured">
            <h3>The Engrams Runtime (Active Schemas)</h3>
            <div class="matrix-flaw text-burgundy">Continuous perception &amp; 1ms execution</div>
            <p>
              Autonomously clusters codebase activity, formalizes triggers and directives, and intercepts agent
              edits in 1ms with compact mental models.
            </p>
          </div>
        </div>
      </section>

      <!-- ══ 3. WHAT IS A SCHEMA? (ISOMETRIC EXPLODED PYRAMID) ══ -->
      <section id="what" class="content-section">
        <h2 class="section-heading">What is a Schema?</h2>
        <p class="section-description">
          A Cognitive Schema is not an isolated note. It is the peak of an architectural pyramid:
          <strong>an active mental model</strong> resting on <strong>linked decisions and standards</strong>,
          which anchor directly into your <strong>concrete repository source code</strong>.
        </p>

        <!-- ── THE 3D ISOMETRIC PYRAMID BLUEPRINT (CALIBRATED VERTICAL ALIGNMENT) ── -->
        <div class="pyramid-showcase" data-pyramid>
          <!-- Full-Container Overlay SVG for Leader Lines (Connects Pyramid Directly to Cards) -->
          <svg class="pyramid-overlay-lines" aria-hidden="true">
            <path class="leader-line line-3" data-tier="3" />
            <circle class="leader-dot dot-3-start" data-tier="3" r="4.5" />
            <circle class="leader-dot dot-3-end" data-tier="3" r="4.5" />

            <path class="leader-line line-2" data-tier="2" />
            <circle class="leader-dot dot-2-start" data-tier="2" r="4.5" />
            <circle class="leader-dot dot-2-end" data-tier="2" r="4.5" />

            <path class="leader-line line-1" data-tier="1" />
            <circle class="leader-dot dot-1-start" data-tier="1" r="4.5" />
            <circle class="leader-dot dot-1-end" data-tier="1" r="4.5" />
          </svg>

          <!-- Left Column: The 3D Exploded Isometric SVG Pyramid (Vertically Calibrated) -->
          <div class="pyramid-visual-col">
            <svg viewBox="0 0 680 720" class="isometric-pyramid-svg" aria-label="Exploded 3D Isometric Schema Pyramid">
              <defs>
                <!-- Tier 3: Burgundy & Rose Gradients -->
                <linearGradient id="pyr-t3-left" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#89023e" />
                  <stop offset="100%" stop-color="#550126" />
                </linearGradient>
                <linearGradient id="pyr-t3-right" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#ea638c" />
                  <stop offset="100%" stop-color="#89023e" />
                </linearGradient>

                <!-- Tier 2: Rose & Pale Blush Gradients -->
                <linearGradient id="pyr-t2-top" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#ffffff" />
                  <stop offset="100%" stop-color="#ffd9da" />
                </linearGradient>
                <linearGradient id="pyr-t2-left" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#ba1a5e" />
                  <stop offset="100%" stop-color="#7a0237" />
                </linearGradient>
                <linearGradient id="pyr-t2-right" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#f588a8" />
                  <stop offset="100%" stop-color="#ea638c" />
                </linearGradient>

                <!-- Tier 1: Foundation Slate Gradients -->
                <linearGradient id="pyr-t1-top" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#fcf0f2" />
                  <stop offset="100%" stop-color="#edd2d6" />
                </linearGradient>
                <linearGradient id="pyr-t1-left" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#30343f" />
                  <stop offset="100%" stop-color="#1b2021" />
                </linearGradient>
                <linearGradient id="pyr-t1-right" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#4d5364" />
                  <stop offset="100%" stop-color="#30343f" />
                </linearGradient>

                <filter id="tier-shadow" x="-20%" y="-20%" width="140%" height="140%">
                  <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#89023e" flood-opacity="0.14" />
                </filter>
              </defs>

              <!-- Isometric Alignment Guidelines -->
              <g class="guide-struts" stroke="#ffd9da" stroke-width="1" stroke-dasharray="3 3">
                <line x1="330" y1="60" x2="10" y2="595" />
                <line x1="330" y1="60" x2="650" y2="595" />
                <line x1="330" y1="160" x2="330" y2="675" />
              </g>

              <!-- ── TIER 1: BASE PLATFORM (Code Anchors) ── -->
              <g class="svg-tier-group tier-1-group" data-tier="1" filter="url(#tier-shadow)">
                <!-- Top Face (Diamond) -->
                <polygon points="330,470 547,525 330,580 113,525" fill="url(#pyr-t1-top)" stroke="#e0c2c6" stroke-width="1.5" />
                <!-- Left Face -->
                <polygon points="113,525 330,580 330,675 10,595" fill="url(#pyr-t1-left)" stroke="#1b2021" stroke-width="1" />
                <!-- Right Face -->
                <polygon points="330,580 547,525 650,595 330,675" fill="url(#pyr-t1-right)" stroke="#1b2021" stroke-width="1" />
                <!-- Subtle Facet Line -->
                <line x1="330" y1="580" x2="330" y2="675" stroke="#ffd9da" stroke-width="1.5" opacity="0.6" />
                <!-- Label on Base -->
                <text x="140" y="615" fill="#ffffff" font-family="var(--font-mono)" font-size="11" font-weight="800" letter-spacing="1" transform="rotate(16, 140, 615)">TIER 1: REPOSITORY CODE ANCHORS</text>
                <!-- Anchor Dot for Leader Line -->
                <circle id="tier-anchor-1" cx="598" cy="560" r="4.5" fill="#89023e" />
              </g>

              <!-- ── TIER 2: MIDDLE FRUSTUM (Decisions & Patterns) ── -->
              <g class="svg-tier-group tier-2-group" data-tier="2" filter="url(#tier-shadow)">
                <!-- Top Face (Diamond) -->
                <polygon points="330,250 443,280 330,310 217,280" fill="url(#pyr-t2-top)" stroke="#ffd9da" stroke-width="1.5" />
                <!-- Left Face -->
                <polygon points="217,280 330,310 330,405 131,355" fill="url(#pyr-t2-left)" stroke="#89023e" stroke-width="1" />
                <!-- Right Face -->
                <polygon points="330,310 443,280 529,355 330,405" fill="url(#pyr-t2-right)" stroke="#89023e" stroke-width="1" />
                <!-- Subtle Facet Line -->
                <line x1="330" y1="310" x2="330" y2="405" stroke="#ffd9da" stroke-width="1.5" opacity="0.6" />
                <!-- Label on Middle Tier -->
                <text x="175" y="365" fill="#ffffff" font-family="var(--font-mono)" font-size="10" font-weight="800" letter-spacing="0.5" transform="rotate(16, 175, 365)">TIER 2: DECISIONS &amp; PATTERNS</text>
                <!-- Anchor Dot for Leader Line -->
                <circle id="tier-anchor-2" cx="486" cy="318" r="4.5" fill="#89023e" />
              </g>

              <!-- ── TIER 3: APEX CAP (Cognitive Schema) ── -->
              <g class="svg-tier-group tier-3-group" data-tier="3" filter="url(#tier-shadow)">
                <!-- Left Face (Triangle) -->
                <polygon points="330,60 235,135 330,160" fill="url(#pyr-t3-left)" stroke="#ffd9da" stroke-width="1" />
                <!-- Right Face (Triangle) -->
                <polygon points="330,60 330,160 425,135" fill="url(#pyr-t3-right)" stroke="#ffd9da" stroke-width="1" />
                <!-- Center Crease Highlight -->
                <line x1="330" y1="60" x2="330" y2="160" stroke="#ffffff" stroke-width="1.5" opacity="0.8" />
                <!-- Glowing Apex Peak Point -->
                <circle cx="330" cy="60" r="4.5" fill="#ffffff" stroke="#89023e" stroke-width="2" />
                <!-- Label on Apex -->
                <text x="250" y="130" fill="#ffffff" font-family="var(--font-mono)" font-size="9" font-weight="900" letter-spacing="0.5" transform="rotate(16, 250, 130)">TIER 3: SCHEMA</text>
                <!-- Anchor Dot for Leader Line -->
                <circle id="tier-anchor-3" cx="378" cy="148" r="4.5" fill="#89023e" />
              </g>
            </svg>
          </div>

          <!-- Right Column: The Three Layered Cards -->
          <div class="pyramid-stack-col">
            <!-- Level 3 Card: Schema -->
            <div class="stack-tier-card card-tier-3 is-active" data-tier="3">
              <div class="st-head">
                <h3 class="st-card-heading text-burgundy">Tier 3: Cognitive Schema</h3>
                <span class="st-status text-burgundy">● active mental model</span>
              </div>
              <div class="st-title">
                <code>performance-rules</code>
                <span class="st-telemetry">guided 14 sessions</span>
              </div>
              <div class="st-content">
                <div class="st-field">
                  <span class="st-k">⚡ TRIGGER</span>
                  <p class="st-v">Fires whenever I edit Rust code handling collections &amp; strings</p>
                </div>
                <div class="st-field">
                  <span class="st-k">📋 DIRECTIVE</span>
                  <div class="st-v directive-box">
                    The four allocation rules (borrow params, keep borrowed, consume by move) plus staged checker.
                  </div>
                </div>
              </div>
            </div>

            <!-- Level 2 Card: Decisions -->
            <div class="stack-tier-card card-tier-2" data-tier="2">
              <div class="st-head">
                <h3 class="st-card-heading">Tier 2: Linked Decisions &amp; Patterns</h3>
                <span class="st-status">architectural standards</span>
              </div>
              <div class="st-chips-grid">
                <div class="st-chip">
                  <span class="chip-k">Decision #88</span>
                  <span class="chip-v">Borrowed SQL parameters (Vec&lt;&amp;dyn ToSql&gt;)</span>
                </div>
                <div class="st-chip">
                  <span class="chip-k">Decision #91</span>
                  <span class="chip-v">Static vocabulary returns Cow&lt;str&gt;</span>
                </div>
                <div class="st-chip">
                  <span class="chip-k">Pattern #11</span>
                  <span class="chip-v">Single-source row projections</span>
                </div>
                <div class="st-chip">
                  <span class="chip-k">Pattern #12</span>
                  <span class="chip-v">Enrich by move, not get().clone()</span>
                </div>
                <div class="st-chip chip-tool">
                  <span class="chip-k">Checker Tool</span>
                  <span class="chip-v">engrams check --staged (pre-commit)</span>
                </div>
              </div>
            </div>

            <!-- Level 1 Card: Anchors -->
            <div class="stack-tier-card card-tier-1" data-tier="1">
              <div class="st-head">
                <h3 class="st-card-heading">Tier 1: Repository Code Anchors</h3>
                <span class="st-status">grounded code reality</span>
              </div>
              <div class="st-anchors-list">
                <div class="st-anchor">
                  <span class="anchor-glyph">⚓</span>
                  <code>src/ops/schemas/retrieval.rs</code>
                  <span class="anchor-meta">surface_counts · enrich_members</span>
                </div>
                <div class="st-anchor">
                  <span class="anchor-glyph">⚓</span>
                  <code>src/ops/schemas/list.rs</code>
                  <span class="anchor-meta">resolve_schema · row_json</span>
                </div>
                <div class="st-anchor">
                  <span class="anchor-glyph">⚓</span>
                  <code>src/ops/schemas/gates.rs</code>
                  <span class="anchor-meta">gates_pass · claimed_territory</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Real Specimen 2: Strategic Planning Schema -->
        <div class="specimen-card" style="margin-top: 3.5rem;">
          <div class="sc-header">
            <div class="sc-title">
              <span class="sc-badge badge-rose">STRATEGIC SCHEMA</span>
              <code>what-to-build-next</code>
            </div>
            <div class="sc-meta-group">
              <span class="sc-status">● active · guided 16 sessions</span>
              <span class="sc-centroid">centroid: roadmap: 1 · planning: 1 · versioning: 1</span>
            </div>
          </div>

          <div class="sc-content">
            <div class="sc-row">
              <span class="sc-k">⚡ MENTAL TRIGGER</span>
              <div class="sc-v">
                <strong>When does this mental model activate?</strong>
                <p>Fires when planning releases, evaluating roadmap priorities, or drafting new feature specifications</p>
              </div>
            </div>
            <div class="sc-row">
              <span class="sc-k">📋 CONCEPTUAL DIRECTIVE</span>
              <div class="sc-v">
                <strong>What operational paradigm is enforced?</strong>
                <p class="rule-box warm">
                  The pack that answers "what should engrams do next?": the 2026 agent-memory research survey (8 saved findings), the decision that turned it into a tiered version-by-version roadmap, and the survey session note. My learn → plan → ship loop — read this before writing any new spec.
                </p>
              </div>
            </div>
            <div class="sc-row">
              <span class="sc-k">🔗 BUNDLED MEMBERS</span>
              <div class="sc-v">
                <strong>What decisions, research, and progress notes are unified?</strong>
                <div class="sc-members">
                  <span class="m-pill">Decision #74: Tiered version roadmap</span>
                  <span class="m-pill">Research: 2026 agent-memory survey (8 findings)</span>
                  <span class="m-pill">Progress: Survey session notes &amp; synthesis</span>
                  <span class="m-pill anchor">Anchor: specs/</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="contrast-callout">
          <h3>Why this is an architectural mental model, not a linter rule</h3>
          <p>
            Notice how both schemas capture <strong>how an expert thinks</strong>: 
            <code>performance-rules</code> doesn't just block a single function call; it packages four architectural decisions, two code files, and a validation checker into an instant zero-allocation posture. 
            <code>what-to-build-next</code> packages a research survey and roadmap decisions into a planning protocol. 
            Your AI receives the complete mental model on Turn 1 before writing a single line of code.
          </p>
        </div>
      </section>

      <!-- ══ 4. HOW THE RUNTIME LEARNS: FINDS, DEFINES, REFINES, EXECUTES ══ -->
      <section id="lifecycle" class="content-section">
        <h2 class="section-heading">How the Runtime Learns</h2>
        <p class="section-description">
          The human brain doesn't require manual file editing to form intuition. Engrams runs a continuous
          cognitive loop: perceiving clusters, defining boundaries, adapting to drift, and executing just in time.
        </p>

        <div class="loop-grid">
          <!-- Step 1: Finds -->
          <div class="loop-card">
            <h3>1. Finds</h3>
            <p>
              As you commit code and log decisions, graph community detection identifies natural clusters
              of co-edited files and decisions in local SQLite.
            </p>
            <div class="lc-code"><code>$ engrams schema scan</code></div>
          </div>

          <!-- Step 2: Proposes -->
          <div class="loop-card">
            <h3>2. Proposes</h3>
            <p>
              At session close, Engrams surfaces candidate clusters with ready-to-fill propose commands. Your agent
              drafts a plain-language claim, trigger-and-rule instruction, and scope over the evidence.
            </p>
            <div class="lc-code"><code>$ engrams schema propose --from decision:88 --statement "..." --trigger "..." --rule "..."</code></div>
          </div>

          <!-- Step 3: Confirms & Refines -->
          <div class="loop-card">
            <h3>3. Confirms &amp; Refines</h3>
            <p>
              You confirm or edit the reviewed proposal (or refine existing schemas with claims and scope paths),
              while Engrams tracks drift and retrieval telemetry.
            </p>
            <div class="lc-code"><code>$ engrams schema confirm proposal:1</code></div>
          </div>

          <!-- Step 4: Executes -->
          <div class="loop-card lc-featured">
            <h3>4. Executes</h3>
            <p>
              Tomorrow, your AI touches matching files. <code>engrams advise</code> intercepts the edit in 1ms,
              injecting the active schema before a single line is written.
            </p>
            <div class="lc-code"><code>$ engrams advise src/ops/schemas/retrieval.rs</code></div>
          </div>
        </div>
      </section>

      <!-- ══ 5. THREE COMMANDS THAT RUN IT ══ -->
      <section class="content-section">
        <h2 class="section-heading">Three Operational Levers</h2>
        <p class="section-description">
          Your AI executes the advice automatically. You steer the runtime with three high-leverage commands.
        </p>

        <div class="cmd-stack">
          <div class="cmd-box">
            <div class="cb-chrome">
              <span class="cb-cmd">$ engrams advise src/ops/schemas/retrieval.rs</span>
            </div>
            <pre class="cb-body"><code>&#123;
  "schemas": [
    &#123;
      "id": 1,
      "name": "performance-rules",
      "statement": "Hot retrieval and enrichment paths must avoid avoidable allocations and clones",
      "summary": "Fires whenever I edit Rust code that creates, copies, or hands off collections...",
      "scope": &#123;"tags": ["performance", "rust"], "paths": ["src/ops"]&#125;,
      "matched_by": &#123;"via": "member_anchor", "value": "src/ops/schemas/retrieval.rs"&#125;,
      "guided": 14
    &#125;
  ],
  "constraints": [ ... ]
&#125;</code></pre>
          </div>

          <div class="cmd-box">
            <div class="cb-chrome">
              <span class="cb-cmd">$ engrams schema show performance-rules</span>
            </div>
            <pre class="cb-body"><code>&#123;
  "name": "performance-rules",
  "statement": "Hot retrieval and enrichment paths must avoid avoidable allocations and clones",
  "summary": "Fires whenever I edit Rust code that creates, copies, or hands off collections...",
  "scope": &#123;"tags": ["performance", "rust"], "paths": ["src/ops"]&#125;,
  "origin": &#123;"proposal_id": 1, "source": &#123;"kind": "candidate", "ref": "decision:88,decision:91"&#125;&#125;,
  "guided": 14,
  "members": [
    &#123;"kind": "decision", "id": 88, "summary": "Borrowed SQL parameter lists"&#125;,
    &#123;"kind": "decision", "id": 91, "summary": "Static vocabulary returns Cow"&#125;
  ]
&#125;</code></pre>
          </div>

          <div class="cmd-box">
            <div class="cb-chrome">
              <span class="cb-cmd">$ engrams session close --pr 42</span>
            </div>
            <pre class="cb-body"><code>&#123;
  "schema_value": &#123;"guided_retrievals": 6, "distinct_schemas": 2&#125;,
  "schema_opportunities": [
    &#123;"propose_command": "engrams schema propose --from decision:88 --name performance-rules --statement \"&lt;claim&gt;\" --summary \"When &lt;condition&gt;: &lt;directive&gt;\""&#125;
  ]
&#125;</code></pre>
          </div>
        </div>
      </section>

      <!-- ══ 6. INSTALL ══ -->
      <section class="install-section">
        <div class="install-box">
          <h2>Give your AI the mental models it deserves.</h2>
          <p>Local SQLite engine. 0MB background memory. 1ms query execution.</p>
          <div class="install-code">
            <code>cargo install engrams-cli</code>
            <span class="sep">or</span>
            <code>brew install stevebrownlee/tap/engrams</code>
          </div>
          <div class="install-actions">
            <a href="/docs/quick-start" class="btn-action primary">5-Minute Quick Start</a>
            <a href="/docs/guide/cognitive-schemas" class="btn-action secondary">Read the Full Guide</a>
          </div>
        </div>
      </section>
    </main>

    <!-- ── FOOTER ── -->
    <footer class="bottom-footer">
      <div class="footer-wrap">
        <span class="footer-brand">⬡ ENGRAMS · Apache-2.0 · The Schema Runtime for AI Agents</span>
        <div class="footer-links">
          <a href="/docs/guide/cognitive-schemas">Cognitive Schemas</a>
          <a href="/docs/getting-started">Docs</a>
          <a href="/docs/reference/cli">CLI Reference</a>
          <a href="https://github.com/stevebrownlee/engrams-cli" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
    </footer>

    <!-- ── DYNAMIC LEADER LINES & TIER HOVER SCRIPT ── -->
    <script>
      function initPyramid() {
        const showcase = document.querySelector('[data-pyramid]');
        if (!showcase) return;

        const svgGroups = showcase.querySelectorAll('.svg-tier-group');
        const cards = showcase.querySelectorAll('.stack-tier-card');

        function updateConnectors() {
          const sRect = showcase.getBoundingClientRect();

          [3, 2, 1].forEach((tier) => {
            const anchor = document.getElementById(`tier-anchor-${tier}`);
            const card = showcase.querySelector(`.card-tier-${tier}`);
            const path = showcase.querySelector(`.line-${tier}`);
            const dotStart = showcase.querySelector(`.dot-${tier}-start`);
            const dotEnd = showcase.querySelector(`.dot-${tier}-end`);

            if (!anchor || !card || !path) return;

            const aRect = anchor.getBoundingClientRect();
            const cRect = card.getBoundingClientRect();

            // Point 1: Center of anchor dot on the pyramid tier facet
            const x1 = Math.round(aRect.left + aRect.width / 2 - sRect.left);
            const y1 = Math.round(aRect.top + aRect.height / 2 - sRect.top);

            // Point 2: Exact left border of the card box, vertically centered on the box!
            const x2 = Math.round(cRect.left - sRect.left);
            const y2 = Math.round(cRect.top + cRect.height / 2 - sRect.top);

            if (x2 > x1 + 10) {
              // Nearly horizontal dogleg line straight from pyramid tier into the card box
              const midX = Math.round(x1 + (x2 - x1) * 0.45);
              path.setAttribute('d', `M ${x1} ${y1} L ${midX} ${y2} L ${x2} ${y2}`);
              if (dotStart) {
                dotStart.setAttribute('cx', x1);
                dotStart.setAttribute('cy', y1);
                dotStart.style.display = '';
              }
              if (dotEnd) {
                dotEnd.setAttribute('cx', x2);
                dotEnd.setAttribute('cy', y2);
                dotEnd.style.display = '';
              }
              path.style.display = '';
            } else {
              path.style.display = 'none';
              if (dotStart) dotStart.style.display = 'none';
              if (dotEnd) dotEnd.style.display = 'none';
            }
          });
        }

        function activateTier(tierNum) {
          svgGroups.forEach((g) => {
            if (g.getAttribute('data-tier') === tierNum) {
              g.classList.add('is-hovered');
            } else {
              g.classList.remove('is-hovered');
            }
          });
          cards.forEach((c) => {
            if (c.getAttribute('data-tier') === tierNum) {
              c.classList.add('is-active');
            } else {
              c.classList.remove('is-active');
            }
          });
          const path = showcase.querySelector(`.line-${tierNum}`);
          const dotStart = showcase.querySelector(`.dot-${tierNum}-start`);
          const dotEnd = showcase.querySelector(`.dot-${tierNum}-end`);
          [3, 2, 1].forEach((t) => {
            const p = showcase.querySelector(`.line-${t}`);
            const ds = showcase.querySelector(`.dot-${t}-start`);
            const de = showcase.querySelector(`.dot-${t}-end`);
            if (p) p.classList.toggle('is-active', t.toString() === tierNum);
            if (ds) ds.classList.toggle('is-active', t.toString() === tierNum);
            if (de) de.classList.toggle('is-active', t.toString() === tierNum);
          });
        }

        svgGroups.forEach((g) => {
          g.addEventListener('mouseenter', () => {
            activateTier(g.getAttribute('data-tier'));
          });
        });

        cards.forEach((c) => {
          c.addEventListener('mouseenter', () => {
            activateTier(c.getAttribute('data-tier'));
          });
        });

        window.addEventListener('resize', updateConnectors);
        if (window.ResizeObserver) {
          const ro = new ResizeObserver(updateConnectors);
          ro.observe(showcase);
        }
        // Run immediately after layout settles
        setTimeout(updateConnectors, 20);
        setTimeout(updateConnectors, 150);
        setTimeout(updateConnectors, 400);
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initPyramid);
      } else {
        initPyramid();
      }
    </script>
  </body>
</html>

