---
import "../styles/global.css";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Stop burning 50,000 tokens on defensive file reads. Engrams automatically organizes your codebase into Cognitive Schemas — compact mental models that tell your AI agent exactly how to write code before it opens a single file."
    />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Engrams – Cognitive Schemas & Memory for AI Agents</title>
  </head>
  <body class="home-body">
    <!-- ── Header ── -->
    <header class="home-header">
      <div class="hdr-inner">
        <a href="/" class="logo">
          <span class="logo-mark"><img src="/engram.png" alt="" class="graph-img" aria-hidden="true" /></span>
          <span class="logo-text">Engrams</span>
        </a>
        <nav class="hdr-nav">
          <a href="/docs/guide/cognitive-schemas" class="nav-highlight">Schemas</a>
          <a href="/docs/advisor/overview">The Advisor</a>
          <a href="/docs/getting-started">Docs</a>
          <a href="https://github.com/stevebrownlee/engrams-cli" target="_blank" rel="noopener">GitHub</a>
        </nav>
      </div>
    </header>

    <!-- ══ HERO ══ -->
    <section class="hero dark">
      <div class="hero-content">
        <div class="hero-badge">Autonomous Context · Cognitive Schemas · Local SQLite</div>
        <h1 class="hero-title">
          Mental models for your AI agent.<br />
          <span class="accent-word">Stop burning tokens on defensive file reads.</span>
        </h1>
        <p class="hero-subtitle">
          Your AI forgets your codebase between sessions, burning 50,000 tokens reading 15 files
          just to guess your conventions. Engrams automatically organizes your decisions, patterns,
          and code into <em>Cognitive Schemas</em> — compact playbooks that tell your AI how to build
          before it opens a single file.
        </p>
        <div class="hero-actions">
          <a href="/docs/getting-started" class="btn btn-primary btn-lg">Get started in 3 minutes</a>
          <a href="#schemas" class="btn btn-ghost btn-lg">See how schemas work ↓</a>
        </div>

        <!-- ── HERO COMPARISON WIDGET ── -->
        <div class="hero-compare-widget reveal">
          <div class="compare-card compare-card-bad">
            <div class="card-status-bar">
              <span class="status-indicator red"></span>
              <span class="card-title">Traditional Agent: The File-Reading Tax</span>
            </div>
            <div class="card-stats">
              <div class="stat-pill"><strong>14</strong> files read</div>
              <div class="stat-pill"><strong>68,400</strong> tokens burned</div>
              <div class="stat-pill"><strong>45s</strong> tool loop</div>
            </div>
            <p class="card-desc">
              Agent searches blind, opens files defensively to guess architecture, runs out of context, and hallucinates stale patterns.
            </p>
          </div>

          <div class="compare-card compare-card-good">
            <div class="card-status-bar">
              <span class="status-indicator green"></span>
              <span class="card-title">With Engrams: Cognitive Schema Playbook</span>
            </div>
            <div class="card-stats">
              <div class="stat-pill accent"><strong>1</strong> schema loaded</div>
              <div class="stat-pill accent"><strong>260</strong> tokens total</div>
              <div class="stat-pill accent"><strong>1ms</strong> local query</div>
            </div>
            <p class="card-desc">
              <code>advise</code> intercepts the edit and provides the exact trigger, operational rules, and contracts before writing code.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ ANATOMY OF A SCHEMA ══ -->
    <section id="schemas" class="section">
      <div class="section-head reveal">
        <div class="section-eyebrow">The Core Concept</div>
        <h2 class="section-title">What is a <span class="accent-word">Cognitive Schema</span>?</h2>
        <p class="section-sub">
          Senior engineers don't re-read the company manual before every task. They rely on mental models:
          <em>"When I edit database code, I borrow parameters and avoid throwaway collections."</em>
          Schemas give your AI that same expert intuition in under 300 tokens.
        </p>
      </div>

      <div class="schema-specimen-wrap reveal">
        <div class="schema-specimen">
          <div class="specimen-header">
            <div class="specimen-id">
              <span class="badge-kind">schema</span>
              <code>performance-rules</code>
            </div>
            <div class="specimen-meta">
              <span class="specimen-status">● active</span>
              <span class="specimen-guided">guided 14 sessions</span>
            </div>
          </div>

          <div class="specimen-body">
            <div class="specimen-row">
              <span class="specimen-label">⚡ Trigger</span>
              <div class="specimen-value highlight-trigger">
                Fires when editing Rust code that creates, copies, or hands off collections and strings
              </div>
            </div>
            <div class="specimen-row">
              <span class="specimen-label">📋 Rule</span>
              <div class="specimen-value highlight-rule">
                Borrow SQL parameters via Vec&lt;&amp;dyn ToSql&gt;; consume lookup maps by move with remove(); never materialize intermediate throwaway Vecs.
              </div>
            </div>
            <div class="specimen-row">
              <span class="specimen-label">🔗 Members</span>
              <div class="specimen-members">
                <span class="member-pill"><strong>Decision #88</strong>: Borrowed SQL params</span>
                <span class="member-pill"><strong>Decision #91</strong>: Static vocabulary returns Cow</span>
                <span class="member-pill"><strong>Pattern #12</strong>: Enrich by move</span>
                <span class="member-pill anchor"><strong>Anchor</strong>: src/ops/schemas/retrieval.rs</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ TOKEN ECONOMICS & VALUE ══ -->
    <section class="section dark">
      <div class="section-head reveal">
        <div class="section-eyebrow">The Payoff</div>
        <h2 class="section-title">The Token Economics of <span class="accent-word">Mental Models</span></h2>
        <p class="section-sub">
          When AI assistants operate at the schema level rather than the raw file level, token consumption
          collapses and task completion speeds multiply.
        </p>
      </div>

      <div class="stat-grid reveal">
        <div class="stat-card">
          <div class="stat-number">95%</div>
          <div class="stat-title">Fewer Tokens Burned</div>
          <p class="stat-text">A 250-token schema activation replaces 50,000+ tokens of raw source file reads per task.</p>
        </div>
        <div class="stat-card">
          <div class="stat-number">4×</div>
          <div class="stat-title">Faster Velocity</div>
          <p class="stat-text">Eliminates 5 to 10 exploratory tool rounds. The AI receives the playbook immediately and writes correct code on the first turn.</p>
        </div>
        <div class="stat-card">
          <div class="stat-number">0MB</div>
          <div class="stat-title">Background RAM</div>
          <p class="stat-text">No heavy daemons, socket drops, or external vector embedding APIs. Pure, instant compiled Rust on SQLite.</p>
        </div>
      </div>

      <!-- ── COMPARISON TABLE ── -->
      <div class="compare-table reveal" style="margin-top: 3.5rem;">
        <div class="compare-grid">
          <div class="compare-col-header compare-without-cell">Traditional AI Assistant</div>
          <div class="compare-col-header compare-with-cell">With Engrams Cognitive Schemas</div>

          <div class="compare-cell compare-without-cell">
            <p>Opens 10+ source files (50k–150k tokens) just to inspect behaviors, conventions, and signatures</p>
          </div>
          <div class="compare-cell compare-with-cell">
            <p><code>engrams advise</code> provides the exact schema, operational rules, and contracts in &lt;300 tokens</p>
          </div>

          <div class="compare-cell compare-without-cell">
            <p>Agent doesn't know project conventions exist, inventing conflicting architectural duplicates</p>
          </div>
          <div class="compare-cell compare-with-cell">
            <p>Active schemas intercept edits before code is written, ensuring strict conformance</p>
          </div>

          <div class="compare-cell compare-without-cell">
            <p>6-month-old stale docs and decisions mislead the agent into building on outdated code</p>
          </div>
          <div class="compare-cell compare-with-cell">
            <p>Git-backed staleness detection alerts the agent if anchored files changed at HEAD</p>
          </div>

          <div class="compare-cell compare-without-cell">
            <p>Zero visibility into memory utility — you never know if your context docs are helping or hurting</p>
          </div>
          <div class="compare-cell compare-with-cell">
            <p><code>session close</code> reports exact <code>schema_value</code> (guided retrievals) and tokens saved every session</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ THE ZERO-EFFORT LIFECYCLE ══ -->
    <section class="section section-alt">
      <div class="section-head reveal">
        <div class="section-eyebrow">Zero Bookkeeping</div>
        <h2 class="section-title">The loop that <span class="accent-word">closes itself</span></h2>
        <p class="section-sub">
          You don't need to spend hours designing schemas. Engrams detects clusters from your normal work,
          nudges you at session end, and activates schemas automatically.
        </p>
      </div>

      <div class="lifecycle-grid reveal">
        <div class="lifecycle-step">
          <div class="step-badge">1. Auto-Detect</div>
          <h3>Continuous Clustering</h3>
          <p>As you commit code and log decisions, graph community detection identifies cohesive clusters of knowledge and code anchors.</p>
        </div>
        <div class="lifecycle-step">
          <div class="step-badge">2. Session Nudge</div>
          <h3>Ready-to-Run Opportunity</h3>
          <p>Run <code>engrams session close</code>. Engrams surfaces qualifying candidates with a ready-to-run <code>confirm</code> command. Just copy and hit enter.</p>
        </div>
        <div class="lifecycle-step">
          <div class="step-badge">3. Pre-Edit Activation</div>
          <h3>Automatic Interception</h3>
          <p>Tomorrow, your AI touches matching files. <code>engrams advise</code> intercepts the edit and injects the schema playbook before a line is written.</p>
        </div>
        <div class="lifecycle-step">
          <div class="step-badge">4. Verified Payoff</div>
          <h3>Observed Token ROI</h3>
          <p>See <code>schema_value</code> rise at session close and track <code>guided</code> counters in <code>schema list</code>. Proof, not guesswork.</p>
        </div>
      </div>
    </section>

    <!-- ══ THREE COMMANDS DEVELOPERS ACTUALLY CARE ABOUT ══ -->
    <section class="section">
      <div class="section-head reveal">
        <div class="section-eyebrow">Simplicity</div>
        <h2 class="section-title">Three commands that run the loop</h2>
        <p class="section-sub">
          Your AI executes the advice. You steer with three high-leverage commands.
        </p>
      </div>
      <div class="cmd-list">
        <div class="cmd-row reveal">
          <div class="cmd-term">
            <div class="term-bar"><span></span><span></span><span></span></div>
            <pre><code>$ engrams advise src/ops/schemas/retrieval.rs
&#123;
  "schemas": [
    &#123;"id": 1, "name": "performance-rules", "summary": "Fires when editing Rust..."&#125;
  ],
  "constraints": [ ... ]
&#125;</code></pre>
          </div>
          <div class="cmd-copy">
            <h3><code>advise</code> — The automatic pre-edit interceptor</h3>
            <p>Harnesses (omp, Cursor, Claude Code) run this automatically before any file edit. Surfaces matching schemas above low-level constraints.</p>
            <a href="/docs/guide/cognitive-schemas" class="text-link">How schemas activate →</a>
          </div>
        </div>

        <div class="cmd-row reveal">
          <div class="cmd-term">
            <div class="term-bar"><span></span><span></span><span></span></div>
            <pre><code>$ engrams schema show performance-rules
&#123;
  "name": "performance-rules",
  "summary": "Fires when editing Rust code...",
  "guided": 14,
  "members": [ ... ]
&#125;</code></pre>
          </div>
          <div class="cmd-copy">
            <h3><code>schema show</code> — Inspect the mental model</h3>
            <p>View the operational trigger, directives, and up to 20 enriched members (decisions, patterns, code signatures) in a single structured payload.</p>
            <a href="/docs/guide/cognitive-schemas" class="text-link">Designing triggers &amp; rules →</a>
          </div>
        </div>

        <div class="cmd-row reveal">
          <div class="cmd-term">
            <div class="term-bar"><span></span><span></span><span></span></div>
            <pre><code>$ engrams session close --pr 42
&#123;
  "schema_value": &#123;"guided_retrievals": 6, "distinct_schemas": 2&#125;,
  "schema_opportunities": [
    &#123;"confirm_command": "engrams schema confirm decision:10 --name auth-rules"&#125;
  ]
&#125;</code></pre>
          </div>
          <div class="cmd-copy">
            <h3><code>session close</code> — Opportunities &amp; Token ROI</h3>
            <p>Closes the loop: shows how many retrievals schemas guided, validates your PR, and surfaces new candidate schemas with ready-to-run confirm commands.</p>
            <a href="/docs/reference/cli" class="text-link">Session close reference →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ FINAL CTA ══ -->
    <section class="section dark cta-final">
      <div class="cta-inner reveal">
        <h2 class="cta-title">Give your AI the mental models it deserves.<br />Feel the difference in your next session.</h2>
        <div class="cta-install">
          <pre><code>cargo install engrams-cli</code></pre>
          <p class="cta-alt">or <code>brew install stevebrownlee/tap/engrams</code></p>
        </div>
        <div class="hero-actions">
          <a href="/docs/getting-started" class="btn btn-primary btn-lg">Get started in 3 minutes</a>
          <a href="https://github.com/stevebrownlee/engrams-cli" target="_blank" rel="noopener" class="btn btn-ghost btn-lg">Star on GitHub</a>
        </div>
      </div>
    </section>

    <footer class="home-footer">
      <div class="footer-inner">
        <span>Engrams · Apache-2.0 · v{__APP_VERSION__}</span>
        <div class="footer-links">
          <a href="/docs/guide/cognitive-schemas">Cognitive Schemas</a>
          <a href="/docs/getting-started">Docs</a>
          <a href="/docs/reference/cli">CLI Reference</a>
          <a href="https://github.com/stevebrownlee/engrams-cli" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
    </footer>

    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll('.reveal');
      if (reduced) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
          }),
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .home-body { background: var(--color-bg); }

  /* Header */
  .home-header {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    backdrop-filter: blur(10px);
    background: rgba(15,19,32,.85);
    border-bottom: 1px solid rgba(255,255,255,.08);
  }
  .hdr-inner {
    max-width: 76rem; margin: 0 auto; padding: .85rem 1.5rem;
    display: flex; align-items: center; justify-content: space-between;
  }
  .logo { display: flex; align-items: center; gap: .6rem; text-decoration: none; }
  .logo-mark img { width: 26px; height: 26px; display: block; }
  .logo-text { font-weight: 800; font-size: 1.15rem; color: #fff; letter-spacing: -.01em; }
  .hdr-nav { display: flex; gap: 1.6rem; align-items: center; }
  .hdr-nav a { color: #c3cbdd; text-decoration: none; font-size: .95rem; font-weight: 500; transition: color .15s; }
  .hdr-nav a:hover { color: var(--color-accent); }
  .hdr-nav a.nav-highlight {
    color: var(--color-accent);
    font-weight: 700;
  }
  @media (max-width: 720px) { .hdr-nav a:not(:last-child) { display: none; } }

  /* Hero */
  .hero {
    position: relative; min-height: 85vh;
    display: flex; align-items: center; justify-content: center; text-align: center;
    padding: 8rem 1.5rem 4rem;
  }
  .hero-content { position: relative; z-index: 2; max-width: 62rem; }
  .hero-badge {
    display: inline-block; font-family: var(--font-mono); font-size: .78rem;
    letter-spacing: .12em; color: var(--color-accent);
    background: rgba(204,164,59,.1);
    border: 1px solid rgba(204,164,59,.3); border-radius: 999px;
    padding: .4rem 1.1rem; margin-bottom: 1.6rem; font-weight: 600;
  }
  .hero-title {
    font-size: clamp(2.4rem, 6.5vw, 4.4rem); font-weight: 800; line-height: 1.08;
    letter-spacing: -.03em; color: #fff; margin-bottom: 1.4rem;
  }
  .accent-word { color: var(--color-accent); }
  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.25rem); color: var(--dark-text-muted);
    line-height: 1.65; max-width: 48rem; margin: 0 auto 2.2rem;
  }
  .hero-subtitle em { color: #fff; font-style: normal; font-weight: 600; }
  .hero-actions { display: flex; gap: .9rem; justify-content: center; flex-wrap: wrap; margin-bottom: 3.5rem; }

  /* Hero Comparison Widget */
  .hero-compare-widget {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1.4rem;
    text-align: left; max-width: 58rem; margin: 0 auto;
  }
  @media (max-width: 760px) { .hero-compare-widget { grid-template-columns: 1fr; } }

  .compare-card {
    border-radius: var(--radius-lg); padding: 1.6rem;
    background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08);
    box-shadow: 0 12px 30px rgba(0,0,0,.35);
  }
  .compare-card-bad { border-left: 3px solid #e0655f; }
  .compare-card-good {
    border-left: 3px solid var(--color-accent);
    background: rgba(204,164,59,.04);
  }
  .card-status-bar { display: flex; align-items: center; gap: .6rem; margin-bottom: 1rem; }
  .status-indicator { width: 9px; height: 9px; border-radius: 50%; }
  .status-indicator.red { background: #e0655f; box-shadow: 0 0 8px rgba(224,101,95,.6); }
  .status-indicator.green { background: var(--color-accent); box-shadow: 0 0 8px rgba(204,164,59,.6); }
  .card-title { font-size: .95rem; font-weight: 700; color: #fff; letter-spacing: -.01em; }
  .card-stats { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: .9rem; }
  .stat-pill {
    font-family: var(--font-mono); font-size: .78rem; padding: .25rem .6rem;
    border-radius: 4px; background: rgba(255,255,255,.06); color: var(--dark-text-muted);
  }
  .stat-pill strong { color: #fff; }
  .stat-pill.accent { background: rgba(204,164,59,.15); color: var(--color-accent); }
  .stat-pill.accent strong { color: var(--color-accent); }
  .card-desc { font-size: .88rem; color: var(--dark-text-muted); line-height: 1.55; margin: 0; }
  .card-desc code { font-family: var(--font-mono); font-size: .82rem; color: var(--color-accent); }

  /* Generic sections */
  .section { max-width: 76rem; margin: 0 auto; padding: 6rem 1.5rem; }
  .section-alt { background: var(--color-bg-soft); max-width: none; }
  .section-alt > * { max-width: 76rem; margin-left: auto; margin-right: auto; }
  .section-head { text-align: center; max-width: 50rem; margin: 0 auto 3.2rem; }
  .section-eyebrow {
    font-family: var(--font-mono); font-size: .78rem; font-weight: 700;
    letter-spacing: .28em; text-transform: uppercase; color: var(--color-accent); margin-bottom: .9rem;
  }
  .section-title { font-size: clamp(2rem, 4.5vw, 3rem); font-weight: 800; letter-spacing: -.02em; line-height: 1.15; }
  .section-sub { font-size: 1.15rem; color: var(--color-text-muted); margin-top: 1rem; line-height: 1.6; }
  .dark .section-sub { color: var(--dark-text-muted); }
  .dark .section-title { color: var(--dark-text); }

  /* Schema Specimen (Anatomy Card) */
  .schema-specimen-wrap { max-width: 58rem; margin: 0 auto; }
  .schema-specimen {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg);
  }
  .specimen-header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 1rem 1.6rem; background: rgba(255,255,255,.03); border-bottom: 1px solid var(--color-border);
    flex-wrap: wrap; gap: .7rem;
  }
  .specimen-id { display: flex; align-items: center; gap: .6rem; }
  .badge-kind {
    font-family: var(--font-mono); font-size: .72rem; text-transform: uppercase;
    font-weight: 700; background: var(--color-accent); color: #1a1405; padding: .15rem .5rem; border-radius: 4px;
  }
  .specimen-id code { font-family: var(--font-mono); font-size: 1.05rem; font-weight: 700; color: #fff; }
  .specimen-meta { display: flex; gap: 1rem; font-size: .85rem; font-family: var(--font-mono); color: var(--color-text-muted); }
  .specimen-status { color: #5fb87a; }
  .specimen-guided { color: var(--color-accent); }
  .specimen-body { padding: 1.6rem; display: flex; flex-direction: column; gap: 1.3rem; }
  .specimen-row { display: grid; grid-template-columns: 100px 1fr; gap: 1rem; align-items: baseline; }
  @media (max-width: 600px) { .specimen-row { grid-template-columns: 1fr; gap: .4rem; } }
  .specimen-label { font-size: .88rem; font-weight: 700; color: var(--color-text-muted); text-transform: uppercase; letter-spacing: .05em; }
  .specimen-value { font-size: 1rem; line-height: 1.6; color: var(--color-text); }
  .highlight-trigger { color: #fff; font-weight: 600; }
  .highlight-rule {
    color: var(--color-accent); font-family: var(--font-mono); font-size: .92rem;
    background: rgba(204,164,59,.08); padding: .7rem 1rem; border-radius: 6px; border: 1px solid rgba(204,164,59,.2);
  }
  .specimen-members { display: flex; gap: .5rem; flex-wrap: wrap; }
  .member-pill {
    font-size: .82rem; font-family: var(--font-mono); padding: .3rem .7rem; border-radius: 4px;
    background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.08); color: var(--dark-text-muted);
  }
  .member-pill.anchor { border-color: rgba(95,184,122,.3); color: #8ad29f; }

  /* Token Economics Stat Grid */
  .stat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.4rem; max-width: 60rem; margin: 0 auto; }
  .stat-card {
    background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08);
    border-radius: var(--radius-lg); padding: 2rem 1.6rem; text-align: center;
  }
  .stat-number { font-size: 3.4rem; font-weight: 900; color: var(--color-accent); line-height: 1; margin-bottom: .6rem; letter-spacing: -.03em; }
  .stat-title { font-size: 1.2rem; font-weight: 700; color: #fff; margin-bottom: .6rem; }
  .stat-text { font-size: .92rem; color: var(--dark-text-muted); line-height: 1.6; margin: 0; }

  /* Before/after comparison table */
  .compare-table { max-width: 60rem; margin: 0 auto; }
  .compare-grid {
