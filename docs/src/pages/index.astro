---
import "../styles/global.css";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Stop burning 50,000 tokens on defensive file reads. Engrams provides Cognitive Schemas — 250-token mental models that tell your AI agent how to write code before reading source files."
    />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Engrams — Cognitive Schemas for AI Agents</title>
  </head>
  <body class="signal-body">
    <!-- ── MINIMAL TOP BAR ── -->
    <header class="top-bar">
      <div class="bar-inner">
        <a href="/" class="brand">
          <span class="glyph">⬡</span>
          <span class="name">ENGRAMS</span>
          <span class="version">v0.14.0</span>
        </a>
        <nav class="nav">
          <a href="/docs/guide/cognitive-schemas">Guide</a>
          <a href="/docs/getting-started">Docs</a>
          <a href="/docs/reference/cli">CLI Reference</a>
          <a href="https://github.com/stevebrownlee/engrams-cli" target="_blank" rel="noopener">GitHub ↗</a>
        </nav>
      </div>
    </header>

    <main class="page-content">
      <!-- ══ 1. THE CORE VALUE PROPOSITION ══ -->
      <section class="hero-signal">
        <div class="signal-kicker">LOCAL SQLITE RUNTIME · 0MB BACKGROUND RAM · 1MS EXECUTION</div>
        <h1 class="signal-title">
          Stop burning 50,000 tokens<br />
          <span class="accent">teaching your AI the same architecture.</span>
        </h1>
        <p class="signal-lede">
          AI coding agents forget your codebase between sessions. To guess your conventions, they burn
          tens of thousands of tokens reading files defensively. Engrams automatically organizes your
          codebase history into <strong>Cognitive Schemas</strong> — compact mental models that tell your
          agent how to build before it opens a single file.
        </p>

        <div class="signal-actions">
          <a href="/docs/quick-start" class="btn-action primary">5-Minute Quick Start</a>
          <a href="/docs/guide/cognitive-schemas" class="btn-action ghost">Read the Schema Guide</a>
        </div>
      </section>

      <!-- ══ 2. THE 10-SECOND PROOF (THE SIGNAL) ══ -->
      <section class="proof-section">
        <div class="proof-grid">
          <div class="proof-box box-bad">
            <div class="box-tag">WITHOUT SCHEMAS</div>
            <div class="box-metric">48,200 tokens · 52s</div>
            <p class="box-desc">
              Agent explores 14 source files defensively trying to guess your conventions. Runs out of
              context, invents duplicate interfaces, and leaks security flaws.
            </p>
          </div>

          <div class="proof-box box-good">
            <div class="box-tag accent">WITH ENGRAMS SCHEMA</div>
            <div class="box-metric accent">260 tokens · 1ms</div>
            <p class="box-desc">
              <code>engrams advise</code> intercepts the edit and provides the exact trigger, operational rules,
              and code contracts upfront. Agent writes compliant code on Turn 1.
            </p>
          </div>
        </div>
      </section>

      <!-- ══ 3. ANATOMY OF A SCHEMA (WHAT IT LOOKS LIKE) ══ -->
      <section class="specimen-section">
        <div class="section-label">WHAT A COGNITIVE SCHEMA LOOKS LIKE</div>
        <div class="specimen-card">
          <div class="sc-header">
            <div class="sc-title">
              <span class="sc-badge">SCHEMA</span>
              <code>payment-adapters</code>
            </div>
            <span class="sc-status">● active · guided 14 sessions</span>
          </div>

          <div class="sc-content">
            <div class="sc-row">
              <span class="sc-k">⚡ TRIGGER</span>
              <span class="sc-v highlight">Fires when editing payment adapter implementations under src/adapters/</span>
            </div>
            <div class="sc-row">
              <span class="sc-k">📋 DIRECTIVE</span>
              <span class="sc-v rule">
                Implement PaymentProvider trait; pass idempotency_key to all charge requests; verify signatures with crypto::constant_time_eq.
              </span>
            </div>
            <div class="sc-row">
              <span class="sc-k">🔗 MEMBERS</span>
              <div class="sc-members">
                <span class="m-pill">ADR #44: PaymentProvider interface contract</span>
                <span class="m-pill">Pattern #8: Constant-time verification</span>
                <span class="m-pill anchor">Anchor: src/adapters/stripe.rs</span>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ══ 4. THREE COMMANDS (HOW YOU RUN IT) ══ -->
      <section class="workflow-section">
        <div class="section-label">THREE COMMANDS THAT RUN THE LOOP</div>
        <div class="terminal-card">
          <div class="tc-header">
            <span class="tc-dot"></span>
            <span class="tc-title">engrams-cli — developer workflow</span>
          </div>
          <div class="tc-body">
            <div class="code-block">
              <span class="comment"># 1. Automatic pre-edit interception (harnesses run this before editing)</span>
              <span class="cmd">$ engrams advise src/adapters/stripe.rs</span>
              <span class="output">&#123; "schemas": [ &#123; "name": "payment-adapters", "summary": "Fires when editing..." &#125; ] &#125;</span>
            </div>

            <div class="code-block">
              <span class="comment"># 2. Inspect the active mental model, rules, and members</span>
              <span class="cmd">$ engrams schema show payment-adapters</span>
            </div>

            <div class="code-block">
              <span class="comment"># 3. Close the session: see tokens saved and receive new schema opportunities</span>
              <span class="cmd">$ engrams session close --pr 42</span>
              <span class="output">&#123; "schema_value": &#123; "guided_retrievals": 6 &#125;, "schema_opportunities": [ ... ] &#125;</span>
            </div>
          </div>
        </div>
      </section>

      <!-- ══ 5. INSTALL & ACTION ══ -->
      <section class="install-section">
        <div class="install-box">
          <h2>Give your AI the mental models it deserves.</h2>
          <p>Zero background daemons. 100% local SQLite. 1ms query time.</p>
          <div class="install-code">
            <code>cargo install engrams-cli</code>
            <span class="sep">or</span>
            <code>brew install stevebrownlee/tap/engrams</code>
          </div>
          <div class="install-actions">
            <a href="/docs/quick-start" class="btn-action primary">5-Minute Quick Start</a>
            <a href="https://github.com/stevebrownlee/engrams-cli" target="_blank" rel="noopener" class="btn-action ghost">Star on GitHub ↗</a>
          </div>
        </div>
      </section>
    </main>

    <!-- ── MINIMAL FOOTER ── -->
    <footer class="bottom-footer">
      <div class="footer-wrap">
        <span>⬡ ENGRAMS · Apache-2.0 · Local Cognitive Architecture</span>
        <div class="footer-links">
          <a href="/docs/guide/cognitive-schemas">Cognitive Schemas</a>
          <a href="/docs/getting-started">Docs</a>
          <a href="/docs/reference/cli">CLI Reference</a>
          <a href="https://github.com/stevebrownlee/engrams-cli" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* ============================================================
     MAXIMUM SIGNAL, ZERO NOISE: MONOCHROME & BRASS LEDGER
     ============================================================ */

  :root {
    --bg-dark: #080a0f;
    --bg-surface: #0e121a;
    --bg-elevated: #131824;
    --border-dim: #1e2636;
    --border-bright: #2d384e;
    --text-white: #ffffff;
    --text-body: #e2e8f0;
    --text-muted: #8e9bb0;
    --brass: #cca43b;
    --brass-bright: #f3ba42;
    --green: #4ade80;
    --red: #f87171;
    --font-mono: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
    --font-sans: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  .signal-body {
    background: var(--bg-dark);
    color: var(--text-body);
    font-family: var(--font-sans);
    line-height: 1.6;
    margin: 0;
    padding: 0;
    -webkit-font-smoothing: antialiased;
  }

  /* ── TOP BAR ── */
  .top-bar {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    background: rgba(8, 10, 15, 0.95);
    border-bottom: 1px solid var(--border-dim);
    backdrop-filter: blur(8px);
  }
  .bar-inner {
    max-width: 68rem;
    margin: 0 auto;
    padding: 0.75rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .brand { display: flex; align-items: baseline; gap: 0.4rem; text-decoration: none; color: var(--text-white); }
  .glyph { color: var(--brass-bright); font-size: 1.1rem; }
  .name { font-family: var(--font-mono); font-weight: 900; font-size: 1rem; letter-spacing: 0.05em; }
  .version { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted); margin-left: 0.2rem; }
  .nav { display: flex; gap: 1.4rem; }
  .nav a { font-family: var(--font-mono); font-size: 0.8rem; color: var(--text-muted); text-decoration: none; transition: color 0.15s; }
  .nav a:hover { color: var(--text-white); }
  @media (max-width: 600px) { .nav a:not(:last-child) { display: none; } }

  /* ── MAIN CONTENT CONTAINER ── */
  .page-content {
    max-width: 68rem;
    margin: 0 auto;
    padding: 7rem 1.5rem 4rem;
  }

  /* ── 1. HERO ── */
  .hero-signal {
    margin-bottom: 4rem;
  }
  .signal-kicker {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    color: var(--brass-bright);
    margin-bottom: 1rem;
  }
  .signal-title {
    font-size: clamp(2.2rem, 5.2vw, 3.8rem);
    font-weight: 900;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--text-white);
    margin: 0 0 1.5rem;
  }
  .signal-title .accent { color: var(--brass-bright); }
  .signal-lede {
    font-size: 1.15rem;
    line-height: 1.65;
    color: var(--text-body);
    max-width: 48rem;
    margin-bottom: 2rem;
  }
  .signal-lede strong { color: var(--text-white); }
  .signal-actions { display: flex; gap: 1rem; flex-wrap: wrap; }

  /* ── SHARP BUTTONS (ZERO PILLS) ── */
  .btn-action {
    display: inline-flex;
    align-items: center;
    padding: 0.7rem 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    border-radius: 2px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.15s;
  }
  .btn-action.primary {
    background: var(--brass-bright);
    color: #080a0f;
    border-color: var(--brass-bright);
  }
  .btn-action.primary:hover {
    background: #ffcf54;
    box-shadow: 0 0 16px rgba(243, 186, 66, 0.4);
  }
  .btn-action.ghost {
    background: transparent;
    color: var(--text-body);
    border-color: var(--border-bright);
  }
  .btn-action.ghost:hover {
    border-color: var(--brass-bright);
    color: var(--brass-bright);
  }

  /* ── 2. PROOF SECTION ── */
  .proof-section {
    margin-bottom: 4.5rem;
  }
  .proof-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  @media (max-width: 720px) { .proof-grid { grid-template-columns: 1fr; } }
  .proof-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: 2px;
    padding: 1.5rem;
  }
  .box-bad { border-top: 3px solid var(--red); }
  .box-good { border-top: 3px solid var(--brass-bright); background: #111520; }
  .box-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }
  .box-tag.accent { color: var(--brass-bright); }
  .box-metric {
    font-family: var(--font-mono);
    font-size: 1.4rem;
    font-weight: 900;
    color: var(--text-white);
    margin-bottom: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .box-metric.accent { color: var(--brass-bright); }
  .box-desc {
    font-size: 0.92rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
  }
  .box-desc code {
    font-family: var(--font-mono);
    color: var(--brass-bright);
    font-size: 0.85em;
  }

  /* ── 3. SPECIMEN SECTION ── */
  .specimen-section {
    margin-bottom: 4.5rem;
  }
  .section-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--brass-bright);
    margin-bottom: 1rem;
  }
  .specimen-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: 2px;
  }
  .sc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1.25rem;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border-dim);
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .sc-title { display: flex; align-items: center; gap: 0.5rem; }
  .sc-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 800;
    background: var(--brass-bright);
    color: #080a0f;
    padding: 0.15rem 0.45rem;
    border-radius: 2px;
  }
  .sc-title code {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-white);
  }
  .sc-status {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--green);
    font-weight: 700;
  }
  .sc-content { padding: 1.5rem; display: flex; flex-direction: column; gap: 1.2rem; }
  .sc-row { display: grid; grid-template-columns: 110px 1fr; gap: 1rem; align-items: baseline; }
  @media (max-width: 600px) { .sc-row { grid-template-columns: 1fr; gap: 0.3rem; } }
  .sc-k {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 800;
    color: var(--text-muted);
  }
  .sc-v { font-size: 0.95rem; color: var(--text-body); }
  .sc-v.highlight { color: var(--text-white); font-weight: 600; }
  .sc-v.rule {
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--text-white);
    background: rgba(204, 164, 59, 0.08);
    border: 1px solid rgba(204, 164, 59, 0.25);
    padding: 0.75rem 1rem;
    border-radius: 2px;
  }
  .sc-members { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .m-pill {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    background: rgba(255,255,255,0.03);
    border: 1px solid var(--border-dim);
    color: var(--text-muted);
    border-radius: 2px;
  }
  .m-pill.anchor { color: var(--green); border-color: rgba(74, 222, 128, 0.3); }

  /* ── 4. WORKFLOW / COMMANDS ── */
  .workflow-section {
    margin-bottom: 4.5rem;
  }
  .terminal-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: 2px;
  }
  .tc-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.25rem;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border-dim);
  }
  .tc-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--brass-bright); }
  .tc-title { font-family: var(--font-mono); font-size: 0.75rem; color: var(--text-muted); font-weight: 700; }
  .tc-body { padding: 1.5rem; display: flex; flex-direction: column; gap: 1.5rem; }
  .code-block { display: flex; flex-direction: column; gap: 0.35rem; font-family: var(--font-mono); font-size: 0.85rem; }
  .comment { color: var(--text-muted); }
  .cmd { color: var(--brass-bright); font-weight: 700; }
  .output { color: #818cf8; font-size: 0.8rem; background: rgba(0,0,0,0.3); padding: 0.4rem 0.75rem; border-radius: 2px; border: 1px solid var(--border-dim); }

  /* ── 5. INSTALL ── */
  .install-section {
    margin-bottom: 2rem;
  }
  .install-box {
    background: var(--bg-surface);
    border: 1px solid var(--border-dim);
    border-radius: 2px;
    padding: 3rem 2rem;
    text-align: center;
  }
  .install-box h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 900;
    color: var(--text-white);
    margin: 0 0 0.6rem;
  }
  .install-box p {
    color: var(--text-muted);
    font-size: 1rem;
    margin: 0 0 1.8rem;
  }
  .install-code {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    background: #090c12;
    border: 1px solid var(--border-bright);
    padding: 0.75rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--brass-bright);
    margin-bottom: 2rem;
    flex-wrap: wrap;
    justify-content: center;
    border-radius: 2px;
  }
  .install-code .sep { color: var(--text-muted); font-size: 0.75rem; text-transform: uppercase; }
  .install-actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  /* ── FOOTER ── */
  .bottom-footer {
    border-top: 1px solid var(--border-dim);
    background: #06070a;
    padding: 2rem 1.5rem;
  }
  .footer-wrap {
    max-width: 68rem;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .footer-links { display: flex; gap: 1.25rem; }
  .footer-links a { color: var(--text-muted); text-decoration: none; }
  .footer-links a:hover { color: var(--brass-bright); }
</style>
