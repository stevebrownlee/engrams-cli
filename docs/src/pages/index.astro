---
import "../styles/global.css";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Stop teaching your AI the same architecture twice. Engrams automatically organizes codebase decisions and patterns into Cognitive Schemas — high-level mental models that tell your AI agent exactly how to write code before reading source files."
    />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Engrams – Cognitive Schemas for AI Coding Agents</title>
  </head>
  <body class="home-body">
    <!-- ── Header ── -->
    <header class="home-header">
      <div class="hdr-inner">
        <a href="/" class="logo">
          <span class="logo-mark"><img src="/engram.png" alt="" class="graph-img" aria-hidden="true" /></span>
          <span class="logo-text">Engrams</span>
        </a>
        <nav class="hdr-nav">
          <a href="#schemas" class="nav-link">Schemas</a>
          <a href="#story" class="nav-link">The Story</a>
          <a href="#economics" class="nav-link">Economics</a>
          <a href="/docs/guide/cognitive-schemas" class="nav-link">Guide</a>
          <a href="/docs/getting-started" class="nav-link">Docs</a>
          <a href="https://github.com/stevebrownlee/engrams-cli" target="_blank" rel="noopener" class="nav-link">GitHub</a>
        </nav>
      </div>
    </header>

    <!-- ══ HERO ══ -->
    <section class="hero dark">
      <div class="hero-content">
        <div class="hero-badge">SYSTEM PROTOCOL · COGNITIVE SCHEMAS · 1MS LOCAL SQLITE</div>
        <h1 class="hero-title">
          Stop teaching your AI<br />
          <span class="accent-word">the same architecture twice.</span>
        </h1>
        <p class="hero-subtitle">
          Every new chat starts with total amnesia. Your AI burns 50,000 tokens reading 15 files
          just to guess your conventions. Engrams automatically organizes your codebase history into
          <strong>Cognitive Schemas</strong> — compact mental models that tell your AI how to build
          before it opens a single file.
        </p>

        <div class="hero-actions">
          <a href="/docs/quick-start" class="btn btn-primary btn-lg">Quick Start in 5 Minutes</a>
          <a href="#story" class="btn btn-ghost btn-lg">Read the Story ↓</a>
        </div>

        <!-- ── HERO SPLIT-PLANE WIDGET ── -->
        <div class="hero-split-plane reveal">
          <div class="plane-card plane-card-bad">
            <div class="plane-header">
              <span class="plane-tag red">AMNESIAC EXPLORATION</span>
              <span class="plane-metric">14 files · 68,400 tokens · 45s</span>
            </div>
            <div class="plane-code-mock">
              <div class="code-line"><span class="c-fn">read_file</span>(<span class="c-str">"src/billing/service.rs"</span>) <span class="c-dim">// 12.4k tokens</span></div>
              <div class="code-line"><span class="c-fn">read_file</span>(<span class="c-str">"src/billing/models.rs"</span>)  <span class="c-dim">// 9.1k tokens</span></div>
              <div class="code-line"><span class="c-fn">read_file</span>(<span class="c-str">"src/api/routes.rs"</span>)      <span class="c-dim">// 15.2k tokens</span></div>
              <div class="code-line"><span class="c-fn">read_file</span>(<span class="c-str">"src/adapters/stripe.rs"</span>)  <span class="c-dim">// 11.8k tokens</span></div>
            </div>
            <div class="plane-footer">
              <span class="icon-bad">✕</span>
              <span>Agent guesses conventions from raw syntax, introduces duplicate interfaces, and leaks timing vulnerabilities.</span>
            </div>
          </div>

          <div class="plane-card plane-card-good">
            <div class="plane-header">
              <span class="plane-tag gold">COGNITIVE PLAYBOOK</span>
              <span class="plane-metric accent">1 schema · 260 tokens · 1ms</span>
            </div>
            <div class="plane-schema-mock">
              <div class="schema-row">
                <span class="sr-label">⚡ Trigger</span>
                <span class="sr-val">Fires when editing payment adapters</span>
              </div>
              <div class="schema-row">
                <span class="sr-label">📋 Directive</span>
                <span class="sr-val highlight">Implement PaymentProvider; use crypto::constant_time_eq; never log raw webhook payloads.</span>
              </div>
            </div>
            <div class="plane-footer">
              <span class="icon-good">✓</span>
              <span><code>advise</code> intercepts the edit and provides the exact rule, contracts, and anchors on Turn 1.</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ THE THREE ERAS ══ -->
    <section id="eras" class="section section-alt">
      <div class="section-head reveal">
        <div class="section-eyebrow">Evolution of AI Tooling</div>
        <h2 class="section-title">From Raw File Dumps to <span class="accent-word">Mental Models</span></h2>
        <p class="section-sub">
          AI tooling is undergoing the same transition as human expertise: moving from memorizing raw facts to applying abstract schemas.
        </p>
      </div>

      <div class="eras-grid reveal">
        <div class="era-card">
          <div class="era-num">ERA 1 · 2023</div>
          <h3>The Raw Prompt Era</h3>
          <div class="era-tagline">Context Window Bloat</div>
          <p>
            Developers pasted entire READMEs and dumped complete file trees into the prompt.
            Result: 100k token bills, attention rot, and slow multi-turn tool loops.
          </p>
          <div class="era-stat bad">~100,000 tokens burned / prompt</div>
        </div>

        <div class="era-card">
          <div class="era-num">ERA 2 · 2024–2025</div>
          <h3>The Memory Store Era</h3>
          <div class="era-tagline">Fragmented Notes</div>
          <p>
            Flat vector databases and static <code>.cursorrules</code> stored isolated ADR notes.
            Result: The agent had 200 notes but no trigger condition — it didn't know <em>which</em> rule applied right now.
          </p>
          <div class="era-stat neutral">200 unorganized notes</div>
        </div>

        <div class="era-card era-card-featured">
          <div class="era-num accent">ERA 3 · NOW</div>
          <h3>The Cognitive Schema Era</h3>
          <div class="era-tagline">Active Mental Models</div>
          <p>
            Engrams clusters decisions, patterns, and code anchors into compact schemas.
            Result: Injected in 1ms before editing, using 95% fewer tokens with senior developer precision.
          </p>
          <div class="era-stat good">260 tokens · 1ms execution</div>
        </div>
      </div>
    </section>

    <!-- ══ A TALE OF TWO PROMPTS (THE STORY) ══ -->
    <section id="story" class="section dark">
      <div class="section-head reveal">
        <div class="section-eyebrow">The Real-World Walkthrough</div>
        <h2 class="section-title">A Tale of <span class="accent-word">Two Prompts</span></h2>
        <p class="section-sub">
          Prompt: <code>"Add webhook signature verification to our Stripe payment adapter."</code>
          Here is what happens under the hood.
        </p>
      </div>

      <div class="story-grid reveal">
        <!-- Scenario A -->
        <div class="story-box story-bad">
          <div class="story-header">
            <h3>Without Schemas: The Amnesiac Agent</h3>
            <span class="story-badge red">48,200 tokens · 52s</span>
          </div>
          <div class="story-timeline">
            <div class="timeline-step">
              <span class="t-dot">1</span>
              <div>
                <strong>Blind Search</strong>
                <p>Agent doesn't know payment adapters must implement <code>PaymentProvider</code> and use constant-time hex comparison.</p>
              </div>
            </div>
            <div class="timeline-step">
              <span class="t-dot">2</span>
              <div>
                <strong>Defensive File Exploration</strong>
                <p>Calls <code>read_file</code> on 4 separate files (48k tokens) trying to discover what helper utilities exist.</p>
              </div>
            </div>
            <div class="timeline-step">
              <span class="t-dot">3</span>
              <div>
                <strong>The Pull Request Rejection</strong>
                <p>Invents a duplicate <code>verify_sig()</code> helper and uses standard string comparison, leaking a timing vulnerability.</p>
              </div>
            </div>
          </div>
          <div class="story-summary bad">
            <strong>Outcome:</strong> 52s wasted, $0.15 burned, and a 20-minute PR review catching architectural violations.
          </div>
        </div>

        <!-- Scenario B -->
        <div class="story-box story-good">
          <div class="story-header">
            <h3>With Engrams: The Primed Architect</h3>
            <span class="story-badge gold">260 tokens · 3.1s</span>
          </div>
          <div class="story-timeline">
            <div class="timeline-step">
              <span class="t-dot gold">1</span>
              <div>
                <strong>Pre-Edit Interception</strong>
                <p>The moment the agent targets <code>src/adapters/stripe.rs</code>, <code>engrams advise</code> fires in 1ms.</p>
              </div>
            </div>
            <div class="timeline-step">
              <span class="t-dot gold">2</span>
              <div>
                <strong>The 260-Token Injection</strong>
                <p>Receives <code>payment-adapters</code> schema: Trigger, <code>PaymentProvider</code> contract, and <code>constant_time_eq</code> rule.</p>
              </div>
            </div>
            <div class="timeline-step">
              <span class="t-dot gold">3</span>
              <div>
                <strong>Turn 1 Compliant Code</strong>
                <p>Zero source files read. Writes the verified implementation matching all codebase conventions on the first try.</p>
              </div>
            </div>
          </div>
          <div class="story-summary good">
            <strong>Outcome:</strong> Merged immediately. <code>session close</code> stamps the PR and records 47,940 tokens saved.
          </div>
        </div>
      </div>
    </section>

    <!-- ══ ANATOMY OF A SCHEMA (INTERACTIVE WORKBENCH) ══ -->
    <section id="schemas" class="section">
      <div class="section-head reveal">
        <div class="section-eyebrow">Interactive Workbench</div>
        <h2 class="section-title">Anatomy of a <span class="accent-word">Cognitive Schema</span></h2>
        <p class="section-sub">
          A schema is not a document. It is an active concept stored in local SQLite that bridges high-level intent to concrete code.
        </p>
      </div>

      <div class="workbench-card reveal" data-workbench>
        <div class="workbench-tabs">
          <button class="wb-tab is-active" data-tab="db">1. Database Memory</button>
          <button class="wb-tab" data-tab="payment">2. Payment Gateway</button>
          <button class="wb-tab" data-tab="auth">3. Auth &amp; Session</button>
        </div>

        <!-- Tab 1: DB -->
        <div class="wb-panel is-active" id="panel-db">
          <div class="panel-meta">
            <span class="panel-name"><code>performance-rules</code></span>
            <span class="panel-badge">STATUS: active · guided 14 sessions</span>
          </div>
          <div class="panel-row">
            <span class="p-label">⚡ Trigger</span>
            <div class="p-val">Fires when editing Rust code that creates, copies, or hands off collections and strings</div>
          </div>
          <div class="panel-row">
            <span class="p-label">📋 Directive</span>
            <div class="p-val code-val">Borrow SQL parameters via Vec&lt;&amp;dyn ToSql&gt;; consume lookup maps by move with remove(); never materialize intermediate throwaway Vecs.</div>
          </div>
          <div class="panel-row">
            <span class="p-label">🔗 Members</span>
            <div class="p-members">
              <span class="member-tag">Decision #88: Borrowed SQL params</span>
              <span class="member-tag">Decision #91: Static vocabulary returns Cow</span>
              <span class="member-tag">Pattern #12: Enrich by move</span>
              <span class="member-tag anchor">Anchor: src/ops/schemas/retrieval.rs</span>
            </div>
          </div>
        </div>

        <!-- Tab 2: Payment -->
        <div class="wb-panel" id="panel-payment">
          <div class="panel-meta">
            <span class="panel-name"><code>payment-adapters</code></span>
            <span class="panel-badge">STATUS: active · guided 9 sessions</span>
          </div>
          <div class="panel-row">
            <span class="p-label">⚡ Trigger</span>
            <div class="p-val">Fires when editing payment adapter implementations under src/adapters/</div>
          </div>
          <div class="panel-row">
            <span class="p-label">📋 Directive</span>
            <div class="p-val code-val">Implement PaymentProvider trait; pass idempotency_key to all charge requests; verify signatures with crypto::constant_time_eq.</div>
          </div>
          <div class="panel-row">
            <span class="p-label">🔗 Members</span>
            <div class="p-members">
              <span class="member-tag">Decision #44: PaymentProvider interface contract</span>
              <span class="member-tag">Pattern #8: Constant-time signature verification</span>
              <span class="member-tag anchor">Anchor: src/adapters/stripe.rs</span>
            </div>
          </div>
        </div>

        <!-- Tab 3: Auth -->
        <div class="wb-panel" id="panel-auth">
          <div class="panel-meta">
            <span class="panel-name"><code>auth-session-tokens</code></span>
            <span class="panel-badge">STATUS: active · guided 18 sessions</span>
          </div>
          <div class="panel-row">
            <span class="p-label">⚡ Trigger</span>
            <div class="p-val">Fires when editing session token validation or login route handlers</div>
          </div>
          <div class="panel-row">
            <span class="p-label">📋 Directive</span>
            <div class="p-val code-val">Validate tokens strictly at boundary middleware; never pass raw JWT strings into domain services; use SessionContext struct.</div>
          </div>
          <div class="panel-row">
            <span class="p-label">🔗 Members</span>
            <div class="p-members">
              <span class="member-tag">Decision #19: Token validation at middleware boundary</span>
              <span class="member-tag">Decision #23: Typed SessionContext envelope</span>
              <span class="member-tag anchor">Anchor: src/middleware/auth.rs</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ THE TOKEN ECONOMICS LEDGER ══ -->
    <section id="economics" class="section dark">
      <div class="section-head reveal">
        <div class="section-eyebrow">The Balance Sheet</div>
        <h2 class="section-title">The Token Economics of <span class="accent-word">Mental Models</span></h2>
        <p class="section-sub">
          Token savings aren't estimated from hand-waving. They are measured directly by Engrams at every session close.
        </p>
      </div>

      <div class="calc-box reveal" data-calc>
        <div class="calc-controls">
          <label for="prompt-range" class="calc-label">
            Team Activity: <strong id="calc-prompts-val">100</strong> agent tasks / day
          </label>
          <input
            type="range"
            id="prompt-range"
            min="10"
            max="500"
            step="10"
            value="100"
            class="calc-slider"
          />
        </div>

        <div class="calc-ledger">
          <div class="ledger-row">
            <span class="ledger-label">Without Engrams (Defensive file exploration)</span>
            <span class="ledger-val bad" id="calc-without-tokens">4,500,000 tokens/day · $13.50/day</span>
          </div>
          <div class="ledger-row">
            <span class="ledger-label">With Engrams Cognitive Schemas</span>
            <span class="ledger-val good" id="calc-with-tokens">26,000 tokens/day · $0.08/day</span>
          </div>
          <div class="ledger-row ledger-total">
            <span class="ledger-label">Net Monthly Savings</span>
            <span class="ledger-val accent" id="calc-savings">4,474,000 tokens/day (99.4% saved) · ~$403/month</span>
          </div>
        </div>
      </div>

      <div class="invariants-grid reveal">
        <div class="inv-card">
          <div class="inv-metric">0 MB</div>
          <div class="inv-title">Background Footprint</div>
          <p>Zero running Node daemons, no Python virtualenvs, zero background socket drops. A compiled Rust CLI that runs in 1ms.</p>
        </div>
        <div class="inv-card">
          <div class="inv-metric">1 ms</div>
          <div class="inv-title">Local SQLite Search</div>
          <p>Built-in FTS5 engine and graph traversal. Zero external embedding APIs, zero network round trips, fully offline.</p>
        </div>
        <div class="inv-card">
          <div class="inv-metric">Git</div>
          <div class="inv-title">Peer Review in PRs</div>
          <p>Automatic <code>export</code> and <code>import</code> transforms database state into human-readable Markdown for team PR reviews.</p>
        </div>
      </div>
    </section>

    <!-- ══ THE ZERO-EFFORT LIFECYCLE ══ -->
    <section class="section section-alt">
      <div class="section-head reveal">
        <div class="section-eyebrow">Zero Maintenance Chores</div>
        <h2 class="section-title">The loop that <span class="accent-word">closes itself</span></h2>
        <p class="section-sub">
          You don't need to be a database administrator. Engrams detects clusters from your git activity,
          nudges you at session close, and activates schemas on demand.
        </p>
      </div>

      <div class="lifecycle-grid reveal">
        <div class="lifecycle-step">
          <div class="step-num">1</div>
          <h3>Continuous Detection</h3>
          <p>As you commit code and log decisions, graph community detection identifies natural clusters of code and decisions in the background.</p>
        </div>
        <div class="lifecycle-step">
          <div class="step-num">2</div>
          <h3>Session-End Nudge</h3>
          <p>Run <code>engrams session close</code>. Engrams surfaces qualifying candidates with a ready-to-run confirm command. Just copy and hit enter.</p>
        </div>
        <div class="lifecycle-step">
          <div class="step-num">3</div>
          <h3>Pre-Edit Activation</h3>
          <p>Tomorrow, your AI touches matching files. <code>engrams advise</code> automatically intercepts the edit and injects the schema playbook.</p>
        </div>
        <div class="lifecycle-step">
          <div class="step-num">4</div>
          <h3>Verified Receipts</h3>
          <p>See <code>schema_value</code> rise at session close and track <code>guided</code> counters in <code>schema list</code>. Proof, not guesswork.</p>
        </div>
      </div>
    </section>

    <!-- ══ THREE COMMANDS DEVELOPERS RUN ══ -->
    <section class="section">
      <div class="section-head reveal">
        <div class="section-eyebrow">Simplicity</div>
        <h2 class="section-title">Three commands that run the loop</h2>
        <p class="section-sub">
          Your AI executes the advice. You steer with three high-leverage commands.
        </p>
      </div>

      <div class="cmd-list">
        <div class="cmd-row reveal">
          <div class="cmd-term">
            <div class="term-bar"><span>$ engrams advise src/adapters/stripe.rs</span></div>
            <pre><code>&#123;
  "schemas": [
    &#123;
      "id": 1,
      "name": "payment-adapters",
      "summary": "Fires when editing payment adapters: implement PaymentProvider..."
    &#125;
  ],
  "constraints": [ ... ]
&#125;</code></pre>
          </div>
          <div class="cmd-copy">
            <h3><code>advise</code> — The Pre-Edit Interceptor</h3>
            <p>Harnesses (omp, Cursor, Claude Code) run this automatically before any file edit. Surfaces matching schemas above low-level constraints.</p>
            <a href="/docs/guide/cognitive-schemas" class="text-link">How schemas activate →</a>
          </div>
        </div>

        <div class="cmd-row reveal">
          <div class="cmd-term">
            <div class="term-bar"><span>$ engrams schema show payment-adapters</span></div>
            <pre><code>&#123;
  "name": "payment-adapters",
  "summary": "Fires when editing payment adapters...",
  "guided": 9,
  "members": [ ... ]
&#125;</code></pre>
          </div>
          <div class="cmd-copy">
            <h3><code>schema show</code> — The Mental Model Inspector</h3>
            <p>View the operational trigger, directives, and up to 20 enriched members (decisions, patterns, code signatures) in a single structured payload.</p>
            <a href="/docs/guide/cognitive-schemas" class="text-link">Designing triggers &amp; rules →</a>
          </div>
        </div>

        <div class="cmd-row reveal">
          <div class="cmd-term">
            <div class="term-bar"><span>$ engrams session close --pr 42</span></div>
            <pre><code>&#123;
  "schema_value": &#123;"guided_retrievals": 6, "distinct_schemas": 2&#125;,
  "schema_opportunities": [
    &#123;"confirm_command": "engrams schema confirm decision:10 --name auth-rules"&#125;
  ]
&#125;</code></pre>
          </div>
          <div class="cmd-copy">
            <h3><code>session close</code> — Opportunities &amp; Token Receipts</h3>
            <p>Closes the loop: shows how many retrievals schemas guided, validates your PR, and surfaces new candidate schemas with ready-to-run confirm commands.</p>
            <a href="/docs/reference/cli" class="text-link">Session close reference →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ FINAL CTA ══ -->
    <section class="section dark cta-final">
      <div class="cta-inner reveal">
        <h2 class="cta-title">Give your AI the mental models it deserves.<br />Feel the difference in your next session.</h2>
        <div class="cta-install">
          <pre><code>cargo install engrams-cli</code></pre>
          <p class="cta-alt">or <code>brew install stevebrownlee/tap/engrams</code></p>
        </div>
        <div class="hero-actions">
          <a href="/docs/quick-start" class="btn btn-primary btn-lg">Quick Start in 5 Minutes</a>
          <a href="https://github.com/stevebrownlee/engrams-cli" target="_blank" rel="noopener" class="btn btn-ghost btn-lg">Star on GitHub</a>
        </div>
      </div>
    </section>

    <footer class="home-footer">
      <div class="footer-inner">
        <span>Engrams · Apache-2.0 · v{__APP_VERSION__}</span>
        <div class="footer-links">
          <a href="/docs/guide/cognitive-schemas">Cognitive Schemas</a>
          <a href="/docs/getting-started">Docs</a>
          <a href="/docs/reference/cli">CLI Reference</a>
          <a href="https://github.com/stevebrownlee/engrams-cli" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
    </footer>

    <script>
      // Interactive workbench tab switching
      document.querySelectorAll('[data-workbench]').forEach((wb) => {
        const tabs = wb.querySelectorAll('.wb-tab');
        const panels = wb.querySelectorAll('.wb-panel');
        tabs.forEach((tab) => {
          tab.addEventListener('click', () => {
            const targetId = 'panel-' + tab.getAttribute('data-tab');
            tabs.forEach((t) => t.classList.remove('is-active'));
            panels.forEach((p) => p.classList.remove('is-active'));
            tab.classList.add('is-active');
            const target = document.getElementById(targetId);
            if (target) target.classList.add('is-active');
          });
        });
      });

      // Interactive token economics calculator
      const rangeInput = document.getElementById('prompt-range');
      const promptsVal = document.getElementById('calc-prompts-val');
      const withoutTokens = document.getElementById('calc-without-tokens');
      const withTokens = document.getElementById('calc-with-tokens');
      const savings = document.getElementById('calc-savings');

      if (rangeInput && promptsVal && withoutTokens && withTokens && savings) {
        rangeInput.addEventListener('input', (e) => {
          const count = parseInt(e.target.value, 10);
          promptsVal.textContent = count.toLocaleString();

          const withoutCount = count * 45000;
          const withoutCost = (withoutCount / 1000000) * 3.0; // ~$3 per M tokens average

          const withCount = count * 260;
          const withCost = (withCount / 1000000) * 3.0;

          const savedTokens = withoutCount - withCount;
          const monthlySaved = (withoutCost - withCost) * 30;
          const pctSaved = ((savedTokens / withoutCount) * 100).toFixed(1);

          withoutTokens.textContent = `${withoutCount.toLocaleString()} tokens/day · $${withoutCost.toFixed(2)}/day`;
          withTokens.textContent = `${withCount.toLocaleString()} tokens/day · $${withCost.toFixed(2)}/day`;
          savings.textContent = `${savedTokens.toLocaleString()} tokens/day (${pctSaved}% saved) · ~$${Math.round(monthlySaved)}/month`;
        });
      }

      // Scroll reveal
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll('.reveal');
      if (reduced) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
          }),
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
