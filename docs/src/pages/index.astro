---
import "../styles/global.css";
import Hero3D from "../components/Hero3D.astro";
import ScrollStory from "../components/ScrollStory.astro";
import ForceGraph from "../components/ForceGraph.astro";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="Engrams turns your AI coding assistant into an active advisor. It anchors every decision, pattern, and trade-off to your code as a knowledge graph that compounds — so the longer you use it, the sharper its guidance gets."
    />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Engrams – Your AI's Active Advisor</title>
  </head>
  <body class="home-body">
    <!-- ── Header ── -->
    <header class="home-header">
      <div class="hdr-inner">
        <a href="/" class="logo">
          <span class="logo-mark"><img src="/engram.png" alt="" class="graph-img" aria-hidden="true" /></span>
          <span class="logo-text">Engrams</span>
        </a>
        <nav class="hdr-nav">
          <a href="/docs/advisor/overview">The Advisor</a>
          <a href="/docs/for-you/overview">For You</a>
          <a href="/docs/for-agent/overview">For Your Agent</a>
          <a href="https://github.com/stevebrownlee/engrams-cli" target="_blank" rel="noopener">GitHub</a>
        </nav>
      </div>
    </header>

    <!-- ══ HERO ══ -->
    <section class="hero dark">
      <Hero3D height="100%" />
      <div class="hero-content">
        <div class="hero-badge">Open Source · Apache-2.0 · v{__APP_VERSION__}</div>
        <h1 class="hero-title">
          An AI advisor that<br /><span class="accent-word">compounds</span>.
        </h1>
        <p class="hero-subtitle">
          Engrams anchors every decision, pattern, and trade-off to your code as a living
          knowledge graph. On day one it fetches. By week four it <em>advises</em> — warning you
          before you repeat a mistake, surfacing the rationale behind any line, and telling your
          agent what breaks if it touches this.
        </p>
        <div class="hero-actions">
          <a href="/docs/getting-started" class="btn btn-primary btn-lg">Start compounding</a>
          <a href="#maturity" class="btn btn-ghost btn-lg">Watch a month of memory ↓</a>
        </div>
      </div>
      <div class="hero-scroll-hint" aria-hidden="true">scroll</div>
    </section>

    <!-- ══ MATURATION SCROLL STORY ══ -->
    <div id="maturity">
      <ScrollStory />
    </div>
    <p class="data-note reveal">
      This is <strong>engrams' own memory</strong> — {33} decisions, {6} patterns, {32} work entries and
      {29} reasoning links captured while building the tool itself. No mock data.
    </p>

    <!-- ══ WHAT AN ADVISOR DOES ══ -->
    <section class="section">
      <div class="section-head reveal">
        <div class="section-eyebrow">The difference</div>
        <h2 class="section-title">A database answers. An advisor <span class="accent-word">anticipates</span>.</h2>
        <p class="section-sub">
          Query tools wait for you to ask the right question. Engrams builds enough context to
          raise its hand first.
        </p>
      </div>
      <div class="card-grid">
        <article class="glass-card reveal">
          <div class="card-icon" aria-hidden="true">◆</div>
          <h3>It warns you first</h3>
          <p>
            You're about to hand-rollback a migration. Engrams surfaces decision #6 —
            <em>"use the <code>migrate</code> command, never manual SQL"</em> — before you repeat a
            mistake it already watched you make.
          </p>
        </article>
        <article class="glass-card reveal">
          <div class="card-icon" aria-hidden="true">◈</div>
          <h3>It explains the why</h3>
          <p>
            Any line of code traces back to the trade-off that created it. Ask why the graph uses
            PageRank and get the rationale, the rejected alternatives, and the incident that forced it.
          </p>
        </article>
        <article class="glass-card reveal">
          <div class="card-icon" aria-hidden="true">◇</div>
          <h3>It protects the boundaries</h3>
          <p>
            Every <code>refines</code> and <code>depends_on</code> link is a tripwire. Touch a
            load-bearing decision and engrams tells your agent exactly what else moves.
          </p>
        </article>
      </div>
    </section>

    <!-- ══ FOR YOU — the human commands ══ -->
    <section class="section section-alt">
      <div class="section-head reveal">
        <div class="section-eyebrow">For you</div>
        <h2 class="section-title">Three commands you'll actually run</h2>
        <p class="section-sub">
          Your agent does the remembering. You get the briefing.
        </p>
      </div>
      <div class="cmd-list">
        <div class="cmd-row reveal">
          <div class="cmd-term">
            <div class="term-bar"><span></span><span></span><span></span></div>
            <pre><code>$ engrams prime
&#123;"briefing": "3 active threads, 1 blocked…",
 "relevant_decisions": [ … ]&#125;</code></pre>
          </div>
          <div class="cmd-copy">
            <h3><code>prime</code> — the morning briefing</h3>
            <p>One command rehydrates everything relevant to what you're about to touch. Start every session informed, not cold.</p>
            <a href="/docs/for-you/briefing" class="text-link">Briefing commands →</a>
          </div>
        </div>
        <div class="cmd-row reveal">
          <div class="cmd-term">
            <div class="term-bar"><span></span><span></span><span></span></div>
            <pre><code>$ engrams report
→ dashboard.html  (open in browser)</code></pre>
          </div>
          <div class="cmd-copy">
            <h3><code>report</code> — see the whole project</h3>
            <p>A static HTML dashboard of decisions, open threads, and graph health. The state of the work at a glance.</p>
            <a href="/docs/for-you/briefing" class="text-link">See a report →</a>
          </div>
        </div>
        <div class="cmd-row reveal">
          <div class="cmd-term">
            <div class="term-bar"><span></span><span></span><span></span></div>
            <pre><code>$ engrams check
✗ src/ops: pattern "no-throwaway-collect" violated</code></pre>
          </div>
          <div class="cmd-copy">
            <h3><code>check</code> — enforce what you decided</h3>
            <p>Turn logged patterns into checks that run in CI. The standards you agreed on actually hold.</p>
            <a href="/docs/for-you/enforcement" class="text-link">Enforcement →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ══ INTERACTIVE GRAPH ══ -->
    <section class="section dark graph-section">
      <div class="section-head reveal">
        <div class="section-eyebrow">Proof, not promises</div>
        <h2 class="section-title">Drag engrams' own memory around</h2>
        <p class="section-sub">
          Every node is a real decision or task from building this tool. Gold nodes are decisions;
          the bright ones are the load-bearing few everything else depends on.
        </p>
      </div>
      <ForceGraph height="620px" />
      <p class="graph-foot reveal">And this is just the knowledge layer — the full graph, with code topology and git-derived links, spans <strong>802 edges</strong>.</p>
    </section>

    <!-- ══ ADVISOR LOOP ══ -->
    <section class="section">
      <div class="section-head reveal">
        <div class="section-eyebrow">How it compounds</div>
        <h2 class="section-title">The advisor loop</h2>
      </div>
      <ol class="loop reveal">
        <li class="loop-step">
          <span class="loop-num">1</span>
          <h3>Store</h3>
          <p>Your agent logs each decision and pattern as it works — no extra effort from you.</p>
        </li>
        <li class="loop-arrow" aria-hidden="true">→</li>
        <li class="loop-step">
          <span class="loop-num">2</span>
          <h3>Link</h3>
          <p>It connects new knowledge to old: <code>refines</code>, <code>supersedes</code>, <code>depends_on</code>.</p>
        </li>
        <li class="loop-arrow" aria-hidden="true">→</li>
        <li class="loop-step">
          <span class="loop-num">3</span>
          <h3>Surface</h3>
          <p><code>prime</code> and <code>relevant</code> push the right context to the front at the right moment.</p>
        </li>
        <li class="loop-arrow" aria-hidden="true">→</li>
        <li class="loop-step">
          <span class="loop-num">4</span>
          <h3>Act</h3>
          <p>You and your agent decide with full memory. The graph gets denser. Repeat.</p>
        </li>
      </ol>
      <div class="loop-cta reveal">
        <a href="/docs/advisor/overview" class="btn btn-outline">How the advisor works →</a>
      </div>
    </section>

    <!-- ══ FINAL CTA ══ -->
    <section class="section dark cta-final">
      <div class="cta-inner reveal">
        <h2 class="cta-title">Start your graph tonight.<br />Feel the difference in a week.</h2>
        <div class="cta-install">
          <pre><code>cargo install engrams-cli</code></pre>
          <p class="cta-alt">or <code>brew install stevebrownlee/tap/engrams</code></p>
        </div>
        <div class="hero-actions">
          <a href="/docs/getting-started" class="btn btn-primary btn-lg">Get started</a>
          <a href="https://github.com/stevebrownlee/engrams-cli" target="_blank" rel="noopener" class="btn btn-ghost btn-lg">Star on GitHub</a>
        </div>
      </div>
    </section>

    <footer class="home-footer">
      <div class="footer-inner">
        <span>Engrams · Apache-2.0 · v{__APP_VERSION__}</span>
        <div class="footer-links">
          <a href="/docs/getting-started">Docs</a>
          <a href="/docs/reference/cli">CLI Reference</a>
          <a href="/docs/reference/releases">Releases</a>
          <a href="https://github.com/stevebrownlee/engrams-cli" target="_blank" rel="noopener">GitHub</a>
        </div>
      </div>
    </footer>

    <script>
      // Scroll-reveal for elements not handled by the pinned story.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const els = document.querySelectorAll('.reveal');
      if (reduced) {
        els.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
          }),
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>

<style>
  .home-body { background: var(--color-bg); }

  /* Header */
  .home-header {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    backdrop-filter: blur(10px);
    background: rgba(15,19,32,.72);
    border-bottom: 1px solid rgba(255,255,255,.06);
  }
  .hdr-inner {
    max-width: 76rem; margin: 0 auto; padding: .85rem 1.5rem;
    display: flex; align-items: center; justify-content: space-between;
  }
  .logo { display: flex; align-items: center; gap: .6rem; text-decoration: none; }
  .logo-mark img { width: 26px; height: 26px; display: block; }
  .logo-text { font-weight: 800; font-size: 1.15rem; color: #fff; letter-spacing: -.01em; }
  .hdr-nav { display: flex; gap: 1.6rem; }
  .hdr-nav a { color: #c3cbdd; text-decoration: none; font-size: .95rem; font-weight: 500; transition: color .15s; }
  .hdr-nav a:hover { color: var(--color-accent); }
  @media (max-width: 720px) { .hdr-nav a:not(:last-child) { display: none; } }

  /* Hero */
  .hero {
    position: relative; min-height: 100vh;
    display: flex; align-items: center; justify-content: center; text-align: center;
    padding: 7rem 1.5rem 4rem; overflow: hidden;
  }
  .hero-content { position: relative; z-index: 2; max-width: 56rem; }
  .hero-badge {
    display: inline-block; font-family: var(--font-mono); font-size: .78rem;
    letter-spacing: .12em; color: var(--dark-text-muted);
    border: 1px solid rgba(255,255,255,.14); border-radius: 999px;
    padding: .4rem 1rem; margin-bottom: 1.6rem;
  }
  .hero-title {
    font-size: clamp(2.6rem, 7vw, 4.8rem); font-weight: 800; line-height: 1.04;
    letter-spacing: -.03em; color: #fff; margin-bottom: 1.4rem;
  }
  .accent-word { color: var(--color-accent); }
  .hero-subtitle {
    font-size: clamp(1.05rem, 2vw, 1.28rem); color: var(--dark-text-muted);
    line-height: 1.65; max-width: 44rem; margin: 0 auto 2.2rem;
  }
  .hero-subtitle em { color: var(--dark-text); font-style: normal; font-weight: 600; }
  .hero-actions { display: flex; gap: .9rem; justify-content: center; flex-wrap: wrap; }
  .hero-scroll-hint {
    position: absolute; bottom: 1.6rem; left: 50%; transform: translateX(-50%);
    font-family: var(--font-mono); font-size: .72rem; letter-spacing: .3em;
    text-transform: uppercase; color: rgba(255,255,255,.35); z-index: 2;
    animation: hint-float 2.2s ease-in-out infinite;
  }
  @keyframes hint-float { 0%,100% { transform: translate(-50%,0); } 50% { transform: translate(-50%,8px); } }

  /* Data note */
  .data-note {
    max-width: 44rem; margin: 0 auto; padding: 2rem 1.5rem 0; text-align: center;
    color: var(--dark-text-muted); font-size: .98rem;
  }
  .data-note strong { color: var(--color-accent); }

  /* Generic sections */
  .section { max-width: 76rem; margin: 0 auto; padding: 6rem 1.5rem; }
  .section-alt { background: var(--color-bg-soft); max-width: none; }
  .section-alt > * { max-width: 76rem; margin-left: auto; margin-right: auto; }
  .section-head { text-align: center; max-width: 46rem; margin: 0 auto 3.2rem; }
  .section-eyebrow {
    font-family: var(--font-mono); font-size: .78rem; font-weight: 700;
    letter-spacing: .28em; text-transform: uppercase; color: var(--color-accent); margin-bottom: .9rem;
  }
  .section-title { font-size: clamp(1.9rem, 4.5vw, 3rem); font-weight: 800; letter-spacing: -.02em; line-height: 1.1; }
  .section-sub { font-size: 1.1rem; color: var(--color-text-muted); margin-top: 1rem; line-height: 1.6; }
  .dark .section-sub { color: var(--dark-text-muted); }
  .dark .section-title { color: var(--dark-text); }

  /* Advisor capability cards */
  .card-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.4rem; }
  .glass-card { padding: 2rem 1.8rem; }
  .card-icon { font-size: 1.6rem; color: var(--color-accent); margin-bottom: 1rem; }
  .glass-card h3 { font-size: 1.28rem; font-weight: 700; margin-bottom: .7rem; }
  .glass-card p { color: var(--color-text-muted); line-height: 1.65; font-size: .98rem; }
  .glass-card code { font-size: .88em; }

  /* For-you command rows */
  .cmd-list { display: flex; flex-direction: column; gap: 2.6rem; }
  .cmd-row {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2.4rem; align-items: center;
  }
  .cmd-row:nth-child(even) .cmd-term { order: 2; }
  @media (max-width: 820px) { .cmd-row { grid-template-columns: 1fr; } .cmd-row:nth-child(even) .cmd-term { order: 0; } }
  .cmd-term {
    background: var(--gunmetal); border-radius: var(--radius-lg); overflow: hidden;
    border: 1px solid rgba(255,255,255,.08); box-shadow: var(--shadow-md);
  }
  .term-bar { display: flex; gap: .45rem; padding: .7rem .9rem; background: rgba(255,255,255,.04); }
  .term-bar span { width: 11px; height: 11px; border-radius: 50%; background: rgba(255,255,255,.18); }
  .term-bar span:first-child { background: #e0655f; }
  .term-bar span:nth-child(2) { background: #e3b84e; }
  .term-bar span:nth-child(3) { background: #5fb87a; }
  .cmd-term pre { padding: 1.1rem 1.2rem; overflow-x: auto; }
  .cmd-term code { font-family: var(--font-mono); font-size: .86rem; color: #dbe2ef; line-height: 1.6; }
  .cmd-copy h3 { font-size: 1.35rem; font-weight: 700; margin-bottom: .6rem; }
  .cmd-copy p { color: var(--color-text-muted); line-height: 1.65; margin-bottom: .8rem; }
  .text-link { color: var(--color-accent); font-weight: 600; text-decoration: none; }
  .text-link:hover { text-decoration: underline; }

  /* Graph section */
  .graph-section { max-width: none; }
  .graph-section > * { max-width: 76rem; margin-left: auto; margin-right: auto; }
  .graph-foot { text-align: center; color: var(--dark-text-muted); margin-top: 1.4rem; font-size: .95rem; }
  .graph-foot strong { color: var(--color-accent); }

  /* Advisor loop */
  .loop {
    display: flex; align-items: stretch; justify-content: center; gap: 1rem;
    list-style: none; flex-wrap: wrap; margin-bottom: 2.6rem;
  }
  .loop-step {
    flex: 1 1 180px; max-width: 240px; background: var(--color-surface);
    border: 1px solid var(--color-border); border-radius: var(--radius-lg);
    padding: 1.6rem 1.3rem; text-align: center;
  }
  .loop-num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 50%;
    background: var(--color-accent); color: #1a1405; font-weight: 800; margin-bottom: .8rem;
  }
  .loop-step h3 { font-size: 1.15rem; margin-bottom: .5rem; }
  .loop-step p { font-size: .92rem; color: var(--color-text-muted); line-height: 1.55; }
  .loop-arrow { align-self: center; color: var(--color-accent); font-size: 1.5rem; font-weight: 700; }
  @media (max-width: 820px) { .loop-arrow { transform: rotate(90deg); } }
  .loop-cta { text-align: center; }

  /* Final CTA */
  .cta-final { text-align: center; }
  .cta-title { font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 800; letter-spacing: -.02em; color: #fff; margin-bottom: 2rem; }
  .cta-install pre {
    display: inline-block; background: rgba(0,0,0,.35); border: 1px solid rgba(255,255,255,.1);
    border-radius: var(--radius-md); padding: .9rem 1.4rem; margin-bottom: .5rem;
  }
  .cta-install code { font-family: var(--font-mono); color: var(--color-accent); font-size: 1.05rem; }
  .cta-alt { color: var(--dark-text-muted); font-size: .9rem; margin-bottom: 2rem; }
  .cta-alt code { font-family: var(--font-mono); }

  /* Footer */
  .home-footer { border-top: 1px solid var(--color-border); background: var(--color-bg); }
  .footer-inner {
    max-width: 76rem; margin: 0 auto; padding: 2rem 1.5rem;
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    color: var(--color-text-muted); font-size: .9rem;
  }
  .footer-links { display: flex; gap: 1.5rem; }
  .footer-links a { color: var(--color-text-muted); text-decoration: none; }
  .footer-links a:hover { color: var(--color-accent); }
</style>
